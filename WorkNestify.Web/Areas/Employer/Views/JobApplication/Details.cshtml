@model WorkNestify.Models.Models.JobApplications.JobApplication

@{
    ViewData["Title"] = "Application Details";
}

<div class="container mt-4">
    <partial name="_NotificationsPartial"/>

    <div class="row mb-3 align-items-center">
        <div class="col-md-8">
            <h1 class="display-6 text-primary">
                <i class="bi bi-file-earmark-person-fill me-2"></i>Application Details
            </h1>
            <p class="text-muted">Detailed view of job application</p>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="btn-group" role="group">
                <a asp-action="Index" class="btn btn-outline-primary shadow-sm me-2" title="Return to applications list">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
                <button class="btn btn-success accept-application"
                        data-id="@Model.Id"
                        title="Accept application"
                        @(Model.Status?.ToLower() != "pending" ? "disabled" : "")>
                    <i class="bi bi-check-circle me-2"></i>Accept
                </button>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                Application for: @Model.Job?.Title
                <span class="badge float-end @(Model.Status?.ToLower() == "pending" ? "bg-secondary" : Model.Status?.ToLower() == "reviewed" ? "bg-success" : "bg-info")">
                    @Model.Status
                </span>
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <!-- Applicant Information -->
                <div class="col-md-6">
                    <h6 class="text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-person-fill me-2"></i>Applicant Information
                    </h6>
                    <dl class="row">
                        <dt class="col-sm-4">Full Name</dt>
                        <dd class="col-sm-8">@(Model.ApplicationUser?.FullName != null ? Model.ApplicationUser.FullName : "Not specified")</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            <a href="mailto:@Model.ApplicationUser?.Email">@Model.ApplicationUser?.Email</a>
                        </dd>

                        <dt class="col-sm-4">Phone Number</dt>
                        <dd class="col-sm-8">@(Model.ApplicationUser?.PhoneNumber != null ? Model.ApplicationUser.PhoneNumber : "Not specified")</dd>
                    </dl>
                </div>

                <!-- Application Details -->
                <div class="col-md-6">
                    <h6 class="text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-file-earmark-text me-2"></i>Application Details
                    </h6>
                    <dl class="row">
                        <dt class="col-sm-4">Resume</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.Resume))
                            {
                                <a href="@Model.Resume" class="btn btn-sm btn-outline-primary" target="_blank" title="Download Resume">
                                    <i class="bi bi-download me-2"></i>Download Resume
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Cover Letter</dt>
                        <dd class="col-sm-8">
                            @if (!string.IsNullOrEmpty(Model.CoverLetter))
                            {
                                <a href="@Model.CoverLetter" class="btn btn-sm btn-outline-primary" target="_blank" title="Download Cover Letter">
                                    <i class="bi bi-download me-2"></i>Download Cover Letter
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not provided</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <hr class="my-4">

            <div class="row">
                <!-- Job Information -->
                <div class="col-md-6">
                    <h6 class="text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-briefcase-fill me-2"></i>Job Information
                    </h6>
                    <dl class="row">
                        <dt class="col-sm-4">Job Title</dt>
                        <dd class="col-sm-8">@Model.Job?.Title</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Html.Raw(Model.Job?.Description)</dd>
                    </dl>
                </div>

                <!-- Dates -->
                <div class="col-md-6">
                    <h6 class="text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-calendar-fill me-2"></i>Dates
                    </h6>
                    <dl class="row">
                        <dt class="col-sm-4">Applied On</dt>
                        <dd class="col-sm-8">
                            @(Model.ApplicationDate.HasValue ? Model.ApplicationDate.Value.ToString("dd/MM/yyyy HH:mm") : "Not specified")
                        </dd>

                        <dt class="col-sm-4">Last Modified</dt>
                        <dd class="col-sm-8">
                            @(Model.ModifiedDate.HasValue ? Model.ModifiedDate.Value.ToString("dd/MM/yyyy HH:mm") : "Not modified")
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('[title]').tooltip({
                placement: 'top',
                container: 'body'
            });

            $('.accept-application').on('click', function () {
                const $button = $(this);
                const applicationId = $button.data('id');

                $button.prop('disabled', true);

                $.ajax({
                    url: `/api/JobApplication/reviewed/${applicationId}`,
                    method: 'GET',
                    contentType: 'application/json',
                    success: function (response) {
                        if (response.success) {
                            // Update the status badge
                            const $badge = $('.badge.float-end');
                            $badge.removeClass('bg-secondary bg-info').addClass('bg-success');
                            $badge.text(response.newStatus);
                            // Disable the button after success
                            $button.prop('disabled', true);
                        } else {
                            alert('Failed to accept application: ' + (response.message || 'Unknown error'));
                            $button.prop('disabled', false);
                        }
                    },
                    error: function (xhr) {
                        let errorMsg = 'Error occurred while accepting application';
                        try {
                            const errorData = JSON.parse(xhr.responseText);
                            errorMsg += ': ' + (errorData.message || xhr.statusText);
                        } catch {
                            errorMsg += ': ' + xhr.statusText;
                        }
                        alert(errorMsg);
                        $button.prop('disabled', false);
                    }
                });
            });
        });
    </script>
}