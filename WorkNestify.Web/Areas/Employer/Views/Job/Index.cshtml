@model IEnumerable<WorkNestify.Models.Models.Jobs.Job>

@{
    ViewData["Title"] = "Job Management";
}

<div class="container mt-4">
    <partial name="_NotificationsPartial"/>
    
    <div class="row mb-3 align-items-center">
        <div class="col-md-6">
            <h1 class="display-6 text-primary">
                <i class="bi bi-briefcase-fill me-2"></i>Job Management
            </h1>
            <p class="text-muted">Manage your job postings efficiently.</p>
        </div>
        <div class="col-md-6 text-md-end">
            <a asp-action="Create" class="btn btn-success shadow-sm" title="Create a new job posting">
                <i class="bi bi-plus-circle me-2"></i>Create New Job
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-hover nowrap w-100" id="jobsTable">
                <thead class="table-dark">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Title)</th>
                    <th>@Html.DisplayNameFor(model => model.StreetAddress)</th>
                    <th>@Html.DisplayNameFor(model => model.Salary)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th>@Html.DisplayNameFor(model => model.JobCategory)</th>
                    <th>@Html.DisplayNameFor(model => model.Type)</th>
                    <th>@Html.DisplayNameFor(model => model.Level)</th>
                    <th>@Html.DisplayNameFor(model => model.CreatedDate)</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <style>
        #jobsTable td {
            vertical-align: middle;
        }

        #jobsTable .btn-group {
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
    <script asp-append-version="true">
        $(document).ready(function () {
            const table = $('#jobsTable').DataTable({
                ajax: {
                    url: '/Employer/Job/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    {data: 'title'},
                    {data: 'streetAddress'},
                    {
                        data: 'salary',
                        render: function (data) {
                            return data.toLocaleString('vi-VN') + ' ₫';
                        }
                    },
                    {
                        data: 'status',
                        render: function (data, type, row) {
                            if (type === 'display') {
                                let badgeClass;
                                switch (data?.toLowerCase()) {
                                    case 'open':
                                        badgeClass = 'bg-success';
                                        break;
                                    case 'closed':
                                        badgeClass = 'bg-warning';
                                        break;
                                    case 'pending':
                                        badgeClass = 'bg-secondary';
                                        break;
                                    default:
                                        badgeClass = 'bg-info';
                                }
                                return `<span class="badge ${badgeClass}">${data || 'Unknown'}</span>`;
                            }
                            return data;
                        }
                    },
                    {data: 'jobCategory'},
                    {data: 'type'},
                    {data: 'level'},
                    {
                        data: 'createdDate',
                        render: function (data) {
                            return new Date(data).toLocaleDateString('vi-VN');
                        }
                    },
                    {
                        data: 'id',
                        render: function (data, type, row) {
                            return `<div class="btn-group" role="group">
                                <a href="/Employer/Job/Edit/${data}" class="btn btn-primary" title="Edit this job">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a href="/Employer/Job/Details/${data}" class="btn btn-info" title="View job details">
                                    <i class="bi bi-info-circle"></i>
                                </a>
                                <button class="btn btn-warning toggle-status" data-id="${data}" title="Toggle job status" ${row.status?.toLowerCase() === 'pending' ? 'disabled' : ''}>
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                                <a href="/Employer/Job/Delete/${data}" class="btn btn-danger" title="Delete this job">
                                    <i class="bi bi-trash-fill"></i>
                                </a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: '<"row"<"col-md-6"l><"col-md-6"f>>rt<"row"<"col-md-6"i><"col-md-6"p>>B',
                buttons: [
                    {
                        extend: 'copy',
                        className: 'btn btn-outline-secondary',
                        text: '<i class="bi bi-clipboard me-1"></i> Copy'
                    },
                    {
                        extend: 'csv',
                        className: 'btn btn-outline-secondary',
                        text: '<i class="bi bi-file-earmark-text me-1"></i> CSV'
                    },
                    {
                        extend: 'excel',
                        className: 'btn btn-outline-secondary',
                        text: '<i class="bi bi-file-earmark-excel me-1"></i> Excel'
                    },
                    {
                        extend: 'pdf',
                        className: 'btn btn-outline-secondary',
                        text: '<i class="bi bi-file-earmark-pdf me-1"></i> PDF'
                    },
                    {
                        extend: 'print',
                        className: 'btn btn-outline-secondary',
                        text: '<i class="bi bi-printer me-1"></i> Print'
                    }
                ],
                language: {
                    emptyTable: "No jobs found",
                    search: '<i class="bi bi-search me-2"></i>',
                    searchPlaceholder: 'Search jobs...'
                },
                order: [[7, 'desc']],
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                drawCallback: function () {
                    $('[title]').tooltip({
                        placement: 'top',
                        container: 'body'
                    });
                }
            });

            // Handle status toggle
            $('#jobsTable').on('click', '.toggle-status', function () {
                const $button = $(this);
                const jobId = $button.data('id');

                $button.prop('disabled', true); // Disable button during request

                $.ajax({
                    url: `/api/Job/toggle-job?id=${jobId}`,
                    method: 'POST',
                    contentType: 'application/json',
                    success: function (response) {
                        if (response.success) {
                            table.ajax.reload(null, false);
                        } else {
                            alert('Failed to toggle status: ' + (response.message || 'Unknown error'));
                        }
                    },
                    error: function (xhr) {
                        let errorMsg = 'Error occurred while toggling status';
                        try {
                            const errorData = JSON.parse(xhr.responseText);
                            errorMsg += ': ' + (errorData.message || xhr.statusText);
                        } catch {
                            errorMsg += ': ' + xhr.statusText;
                        }
                        alert(errorMsg);
                    },
                    complete: function () {
                        $button.prop('disabled', false); // Re-enable button
                    }
                });
            });
        });
    </script>
}