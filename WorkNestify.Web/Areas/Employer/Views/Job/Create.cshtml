@model WorkNestify.Models.Models.Jobs.Job

@{
    ViewData["Title"] = "Create New Job";
}

<div class="container py-4">
    <partial name="_NotificationsPartial"/>
    
    <h1 class="mb-4">
        <i class="bi bi-briefcase me-2"></i>Create New Job Posting
    </h1>

    <div class="card shadow">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Hidden CompanyId -->
                <input type="hidden" asp-for="CompanyId" value="@ViewBag.CompanyId"/>

                <!-- Job Title -->
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">
                        <i class="bi bi-tag me-2"></i>Job Title
                    </label>
                    <input asp-for="Title" class="form-control" placeholder="Enter job title"/>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">
                        <i class="bi bi-text-paragraph me-2"></i>Description
                    </label>
                    <textarea asp-for="Description" id="editor" class="form-control" rows="4"></textarea>
                    <div id="editor-word-count" class="small text-muted mt-1"></div>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Location Fields -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="ProvinceId" class="form-label fw-bold">
                            <i class="bi bi-geo-alt me-2"></i>Province
                        </label>
                        <select asp-for="ProvinceId" class="form-select"
                                asp-items="@(ViewBag.ProvinceId as SelectList)">
                            <option value="" selected disabled>Select Province</option>
                        </select>
                        <span asp-validation-for="ProvinceId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DistrictId" class="form-label fw-bold">
                            District
                        </label>
                        <select asp-for="DistrictId" class="form-select"
                                asp-items="@(ViewBag.DistrictId as SelectList)">
                            <option value="" selected disabled>Select District</option>
                        </select>
                        <span asp-validation-for="DistrictId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="WardCode" class="form-label fw-bold">
                            Ward
                        </label>
                        <select asp-for="WardCode" class="form-select"
                                asp-items="@(ViewBag.WardCode as SelectList)">
                            <option value="" selected disabled>Select Ward</option>
                        </select>
                        <span asp-validation-for="WardCode" class="text-danger"></span>
                    </div>
                </div>

                <!-- Street Address -->
                <div class="mb-3">
                    <label asp-for="StreetAddress" class="form-label fw-bold">
                        <i class="bi bi-house-door me-2"></i>Street Address
                    </label>
                    <input asp-for="StreetAddress" class="form-control"
                           placeholder="Enter street address"/>
                    <span asp-validation-for="StreetAddress" class="text-danger"></span>
                </div>

                <!-- Salary and Job Details -->
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label asp-for="Salary" class="form-label fw-bold">
                            <i class="bi bi-currency-dollar me-2"></i>Salary
                        </label>
                        <input asp-for="Salary" class="form-control" type="number"
                               placeholder="Enter salary" min="2000000" step="500000"/>
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Type" class="form-label fw-bold">
                            <i class="bi bi-clock me-2"></i>Job Type
                        </label>
                        <select asp-for="Type" class="form-select"
                                asp-items="@(ViewBag.Type as SelectList)"></select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Level" class="form-label fw-bold">
                            <i class="bi bi-bar-chart me-2"></i>Level
                        </label>
                        <select asp-for="Level" class="form-select"
                                asp-items="@(ViewBag.Level as SelectList)"></select>
                        <span asp-validation-for="Level" class="text-danger"></span>
                    </div>
                </div>

                <!-- Dates -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-bold">
                            <i class="bi bi-calendar-event me-2"></i>Start Date
                        </label>
                        <input asp-for="StartDate" class="form-control" type="date"
                               value="@ViewBag.StartDate"/>
                        <span asp-validation-for="StartDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="EndDate" class="form-label fw-bold">
                            End Date
                        </label>
                        <input asp-for="EndDate" class="form-control" type="date"
                               value="@ViewBag.EndDate"/>
                        <span asp-validation-for="EndDate" class="text-danger"></span>
                    </div>
                </div>

                <!-- Job Category -->
                <div class="mb-3">
                    <label asp-for="JobCategoryId" class="form-label fw-bold">
                        <i class="bi bi-bookmark me-2"></i>Job Category
                    </label>
                    <select asp-for="JobCategoryId" class="form-select"
                            asp-items="@(ViewBag.JobCategoryId as SelectList)">
                        <option value="" selected disabled>Select Category</option>
                    </select>
                    <span asp-validation-for="JobCategoryId" class="text-danger"></span>
                </div>

                <!-- Form Buttons -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-2"></i>Create Job
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FormScriptsPartial" />
}