@model IEnumerable<WorkNestify.Models.Models.Companies.CompanyReview>

@{
    ViewData["Title"] = "My Company Reviews";
}

<div class="container mt-5">
    <div class="row justify-content-center animate__animated animate__fadeIn">
        <div class="col-12">
            <!-- Page Title -->
            <h1 class="text-center text-primary mb-4 animate__animated animate__fadeInDown animate__delay-1s">
                @ViewData["Title"]
            </h1>
        </div>

        <div class="col-12 animate__animated animate__fadeInRight animate__delay-1s">
            <!-- Review Listings -->
            <div class="mb-5">
                <!-- Loading spinner -->
                <div id="loading-spinner" class="text-center d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

                <div class="row row-cols-2 justify-content-center g-4" id="review-listings">
                    @if (Model.Any())
                    {
                        @foreach (var review in Model)
                        {
                            <div class="col w-50">
                                <div class="card mx-auto shadow-sm animate__animated animate__fadeInUp animate__delay-2s">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center mb-3">
                                            <!-- Company Logo -->
                                            @if (!string.IsNullOrEmpty(review.Company?.Logo))
                                            {
                                                <img src="@review.Company.Logo" class="me-3" alt="@review.Company.Name Logo" style="height: 80px" />
                                            }
                                            else
                                            {
                                                <div class="me-3 bg-light d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                    <span class="text-muted">No Logo</span>
                                                </div>
                                            }
                                            <!-- Company Name -->
                                            <h5 class="card-title text-primary mb-0">@review.Company?.Name</h5>
                                        </div>

                                        <!-- Review Content -->
                                        <p class="card-text text-muted">@review.Content</p>

                                        <!-- Rating in Stars -->
                                        <div class="star-rating mb-3">
                                            @for (int i = 5; i >= 1; i--)
                                            {
                                                <span class="star @(i <= review.Rating ? "text-warning" : "text-muted")">
                                                    <i class="bi bi-star-fill"></i>
                                                </span>
                                            }
                                        </div>

                                        <!-- Action Buttons -->
                                        <div class="d-flex justify-content-end">
                                            <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-primary me-2">
                                                <i class="bi bi-pencil-square me-1"></i>Edit
                                            </a>
                                            <button type="button" class="btn btn-danger delete-review-btn"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#reviewDeleteModal"
                                                    data-review-id="@review.Id"
                                                    data-review-name="@(review.Company?.Name ?? "this company")">
                                                <i class="bi bi-trash me-1"></i>Delete
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-footer text-muted">
                                        <small>Posted on @review.CreatedDate.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center animate__animated animate__fadeInUp animate__delay-2s">
                            <p class="text-muted">You haven’t submitted any reviews yet.</p>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalReviews > ViewBag.PageSize)
                {
                    <nav aria-label="Review pagination" class="mt-4 animate__animated animate__fadeInUp animate__delay-3s">
                        <div id="pagination-container" class="d-flex justify-content-center"></div>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="reviewDeleteModal" tabindex="-1" aria-labelledby="reviewDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="reviewDeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the review for <strong id="review-name-placeholder"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteReviewForm" method="POST" asp-action="Delete" asp-area="JobSeeker">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="review-id-input" />
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script asp-append-version="true">
        window.reviewPaginationConfig = {
            totalReviews: @(ViewBag.TotalReviews ?? 0),
            pageSize: @(ViewBag.PageSize ?? 6),
            currentPage: @(ViewBag.CurrentPage ?? 1)
        }

        // Handle modal data population
        document.addEventListener('DOMContentLoaded', function () {
            const modal = document.getElementById('reviewDeleteModal');
            if (modal) {
                modal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const reviewId = button.getAttribute('data-review-id');
                    const reviewName = button.getAttribute('data-review-name');

                    // Update modal content
                    const namePlaceholder = modal.querySelector('#review-name-placeholder');
                    const idInput = modal.querySelector('#review-id-input');
                    namePlaceholder.textContent = reviewName;
                    idInput.value = reviewId;

                    // Ensure focus is on the modal close button for accessibility
                    const closeButton = modal.querySelector('.btn-close');
                    if (closeButton) closeButton.focus();
                });
            }
        });
    </script>
    <script src="~/js/ReviewPaginationRenderer.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/StarRating.css" asp-append-version="true" />