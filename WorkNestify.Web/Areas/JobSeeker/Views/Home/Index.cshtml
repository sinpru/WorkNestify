@model List<WorkNestify.Models.Models.Jobs.Job>

@{
    ViewData["Title"] = "Homepage";
}

<div class="row justify-content-center">
    <div class="col-12">
        <!-- Search Bar -->
        <partial name="_SearchBarPartial" />

        <!-- Banner Section -->
        <div class="bg-primary text-white p-4 text-center mb-5 animate__animated animate__fadeIn">
            <h2 class="h3 mb-3">Find Your Dream Job in 24 Hours!</h2>
            <p class="lead mb-4">
                Connect with thousands of job postings daily from top companies across Vietnam.
            </p>
            <a href="@Url.Action("Index", "Job", new { area = "JobSeeker" })" class="btn btn-light btn-lg">
                Explore Opportunities Now
            </a>
        </div>

        <!-- Job Listings Section -->
        <div class="mb-5">
            <h2 class="h4 mb-4 text-primary">Top Job Opportunities</h2>
            <!-- Filters -->
            <form asp-action="Index" asp-controller="Home" asp-area="JobSeeker" method="get">
                <div class="d-flex flex-wrap gap-3 mb-3">
                    <select name="location" class="form-select w-auto" asp-items="ViewBag.ProvinceId" onchange="this.form.submit()">
                        <option value="" selected disabled hidden>Locations</option>
                    </select>
                    <select name="category" class="form-select w-auto" asp-items="ViewBag.JobCategoryId" onchange="this.form.submit()">
                        <option value="" selected disabled hidden>Categories</option>
                    </select>
                </div>
            </form>
            <!-- Job Cards -->
            @if (Model.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="job-listings">
                    @foreach (var job in Model)
                    {
                        @await Html.PartialAsync("_JobCardPartial", job, new ViewDataDictionary(ViewData) { { "Layout", "compact" } })
                    }
                </div>
            }
            else
            {
                <div class="text-center">
                    <p class="text-muted">No top jobs available at the moment.</p>
                </div>
            }

            <!-- Pagination with pagination.js and Bootstrap -->
            @if (ViewBag.TotalJobs > ViewBag.PageSize)
            {
                <nav aria-label="Job pagination" class="mt-4">
                    <div id="pagination-container" class="d-flex justify-content-center"></div>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script asp-append-version="true">
        var totalJobs = @ViewBag.TotalJobs;
        var pageSize = @ViewBag.PageSize;
        var currentPage = @ViewBag.CurrentPage;
        var baseUrlFromRazor = '@Url.Action("Index", "Home", new { area = "JobSeeker" })';
        var searchFromRazor = '@Context.Request.Query["search"]';
        var categoryFromRazor = '@Context.Request.Query["category"]';
        var locationFromRazor = '@Context.Request.Query["location"]';
    </script>
    <script src="~/js/PaginationRenderer.js" asp-append-version="true"></script>
}