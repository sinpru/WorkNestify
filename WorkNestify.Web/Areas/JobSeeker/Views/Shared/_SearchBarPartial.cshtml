<div class="bg-light p-4 mb-4">
    <form asp-action="Index" asp-controller="Job" asp-area="JobSeeker" method="get">
        <div class="row g-3 align-items-center">
            <!-- Search Input -->
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 border-2 fw-bold text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control border-start-0 border-2 shadow-none"
                           placeholder="Job title, keywords..." value="@ViewBag.Search" />
                </div>
            </div>
            <!-- Category Dropdown -->
            <div class="col-md-3">
                <select name="category" class="form-select border-2 shadow-none" asp-items="ViewBag.JobCategoryId">
                    <option value="">All Categories</option>
                </select>
            </div>
            <!-- Location Dropdown -->
            <div class="col-md-3">
                <select name="location" class="form-select border-2 shadow-none" asp-items="ViewBag.ProvinceId">
                    <option value="">All Locations</option>
                </select>
            </div>
            <!-- Submit Button -->
            <div class="col-md-2 text-center">
                <button type="submit" class="btn btn-primary text-uppercase fw-bold">
                    <i class="bi bi-search me-2"></i>Search Jobs
                </button>
            </div>
        </div>
    </form>
</div>