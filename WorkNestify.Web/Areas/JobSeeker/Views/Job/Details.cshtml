@using WorkNestify.Utilities.Constants
@model WorkNestify.Models.Models.Jobs.Job

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10">
            <partial name="_NotificationsPartial"/>

            <!-- Job Header Section -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="text-primary">@Model.Title <span class="badge bg-success">✔</span></h2>
                <div class="d-flex align-items-center">
                    <a href="#" class="btn btn-outline-primary me-2 btn-share"><i class="bi bi-share"></i> Share</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <button class="btn btn-outline-secondary me-2 save-job-btn" data-job-id="@Model.Id">
                            <i class="bi bi-heart save-job-icon"></i> <span class="save-job-text">Save</span>
                        </button>
                    }
                    else
                    {
                        <a href="@Url.Action("Login", "Account", new { area = "Identity" })" class="btn btn-outline-secondary me-2">
                            <i class="bi bi-heart"></i> Log in to Save
                        </a>
                    }
                    <a asp-controller="JobApplication" asp-action="Create" asp-area="JobSeeker" asp-route-jobId="@Model.Id"
                       class="btn btn-outline-success">
                        <i class="bi bi-send me-2"></i>Apply Now
                    </a>
                </div>
            </div>

            <!-- Company and Job Info Card -->
            <div class="card border-light shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div>
                            <h3 class="card-title mb-0">@(Model.Company?.Name ?? "N/A")</h3>
                            <p class="card-subtitle text-muted">Posted
                                on @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
                        </div>
                        <img src="@Model.Company?.Logo" alt="Company Logo" class="me-3" style="height: 80px;"/>
                    </div>

                    <!-- Job Details -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <p class="card-text">
                                <i
                                    class="bi bi-currency-dollar text-success me-2"></i><strong>Salary:</strong>
                                @(Model.Salary.ToString("N0", new System.Globalization.CultureInfo("vi-VN")) + " ₫")</p>
                        </div>
                        <div class="col-md-4">
                            <p class="card-text">
                                <i
                                    class="bi bi-geo-alt text-primary me-2"></i><strong>Location:</strong> @(Model.StreetAddress ?? "N/A"), @(Model.Ward?.Name ?? "N/A"), @(Model.District?.Name ?? "N/A"), @(Model.Province?.Name ?? "N/A")
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p class="card-text">
                                <i
                                    class="bi bi-briefcase text-info me-2"></i><strong>Experience:</strong> @(Model.Level ?? "N/A")
                            </p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <p class="card-text">
                                <i
                                    class="bi bi-clock text-warning me-2"></i><strong>Type:</strong> @(Model.Type ?? "N/A")
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p class="card-text">
                                <i
                                    class="bi bi-tag text-secondary me-2"></i><strong>Category:</strong> @(Model.JobCategory?.Name ?? "N/A")
                            </p>
                        </div>
                        <div class="col-md-4">
                            <p class="card-text">
                                <i
                                    class="bi bi-hourglass-split text-danger me-2"></i><strong>Status:</strong> @(Model.Status ?? "N/A")
                            </p>
                        </div>
                    </div>

                    <!-- Job Description -->
                    <h3 class="mb-3">Job Description</h3>
                    <div class="card-text">
                        @Html.Raw(Model.Description)
                    </div>
                </div>
            </div>

            <!-- Additional Job Details -->
            <div class="card border-light shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Additional Information</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="bi bi-calendar-check text-primary me-2"></i>
                            <strong>Start
                                Date:</strong> @(Model.StartDate?.ToString("dd/MM/yyyy") ?? "N/A")</li>
                        <li class="mb-2"><i class="bi bi-calendar-x text-danger me-2"></i>
                            <strong>End
                                Date:</strong> @(Model.EndDate?.ToString("dd/MM/yyyy") ?? "N/A")</li>
                        <li class="mb-2"><i class="bi bi-clock-history text-muted me-2"></i>
                            <strong>Last
                                Modified:</strong> @Model.ModifiedDate.ToString("dd/MM/yyyy")</li>
                    </ul>
                </div>
            </div>

            <!-- Back to List Button -->
            <div class="text-end mt-4">
                @if (User.Identity.IsAuthenticated && User.IsInRole(Roles.Employer))
                {
                    <a asp-action="Index" asp-controller="Job" asp-area="Employer" class="btn btn-outline-primary">
                        Back to Management
                    </a>
                }
                <a asp-action="Index" asp-controller="Job" asp-area="JobSeeker" class="btn btn-outline-primary">
                    Back to List
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/SaveJobButtonHandler.js" asp-append-version="true"></script>
    <script asp-append-version="true">
        document.addEventListener('DOMContentLoaded', function() {
            // Share button handler
            const shareButton = document.querySelector('.btn-share');
            const jobTitle = '@Model.Title';
            const jobUrl = window.location.href;

            shareButton.addEventListener('click', async function(e) {
                e.preventDefault();

                if (navigator.share) {
                    try {
                        await navigator.share({
                            title: jobTitle,
                            text: 'Check out this job opportunity: ' + jobTitle,
                            url: jobUrl
                        });
                        console.log('Job shared successfully');
                    } catch (error) {
                        console.error('Error sharing:', error);
                    }
                } else {
                    const shareData = {
                        title: jobTitle,
                        url: jobUrl
                    };
                    fallbackShare(shareData);
                }
            });

            // Initialize save job handler if authenticated
            @if (User.Identity.IsAuthenticated)
            {
                @:initializeSaveJobHandler();
            }
        });

        function fallbackShare(data) {
            navigator.clipboard.writeText(`${data.title}\n${data.url}`)
                .then(() => {
                    alert('Job link copied to clipboard!\nTitle: ' + data.title + '\nURL: ' + data.url);
                })
                .catch(err => {
                    alert('Failed to copy to clipboard. Here is the link:\n' + data.url);
                    console.error('Clipboard error:', err);
                });
        }
    </script>
}