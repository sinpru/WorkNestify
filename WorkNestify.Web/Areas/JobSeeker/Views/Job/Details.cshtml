@model WorkNestify.Models.Models.Jobs.Job

@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10">
        <h2 class="h3 mb-4 text-primary">@Model.Title</h2>
        <div class="card border-light shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <img src="https://via.placeholder.com/50" alt="Company Logo" class="me-3 rounded" style="width: 50px; height: 50px;" />
                    <div>
                        <h5 class="card-title mb-0">@(Model.Company?.Name ?? Model.Company?.StreetAddress ?? "N/A")</h5>
                        <p class="card-subtitle text-muted small">Posted on @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>
                <p class="card-text"><strong>Salary:</strong> $@(Model.Salary.ToString("N0"))</p>
                <p class="card-text"><strong>Location:</strong> @(Model.StreetAddress ?? "N/A")</p>
                <p class="card-text"><strong>Category:</strong> @(Model.JobCategory?.Name ?? "N/A")</p>
                <p class="card-text"><strong>Status:</strong> @(Model.Status ?? "N/A")</p>
                <p class="card-text"><strong>Description:</strong> @Html.Raw(Model.Description)</p>
                <div class="text-end">
                    <a asp-action="Index" asp-controller="Job" asp-area="JobSeeker" class="btn btn-outline-primary">Back to List</a>
                </div>
            </div>
        </div>
    </div>
</div>