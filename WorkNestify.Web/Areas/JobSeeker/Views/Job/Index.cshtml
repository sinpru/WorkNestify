@model List<WorkNestify.Models.Models.Jobs.Job>

@{
    ViewData["Title"] = "Jobs List";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-10">
        <!-- Search Bar (same as Home/Index) -->
        <div class="bg-light p-4 rounded-3 shadow-sm mb-4">
            <form asp-action="Index" asp-controller="Job" asp-area="JobSeeker" method="get">
                <div class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="search" class="form-control border-start-0" placeholder="Job title, keyword..." value="@ViewBag.Search" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select name="category" class="form-select" asp-items="ViewBag.JobCategoryId">
                            <option value="">All Categories</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="location" class="form-select" asp-items="ViewBag.ProvinceId">
                            <option value="">All Locations</option>
                        </select>
                    </div>
                    <div class="col-md-12 text-center">
                        <button type="submit" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-search"></i> Search Jobs
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Job Listings -->
        <div class="mb-5">
            <h2 class="h4 mb-4 text-primary">Job Listings</h2>
            @if (Model.Any())
            {
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var job in Model)
                    {
                        <div class="col">
                            <div class="card h-100 border-light shadow-sm">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-2">
                                        <img src="https://via.placeholder.com/40" alt="Company Logo" class="me-2 rounded" style="width: 40px; height: 40px;" />
                                        <div>
                                            <h5 class="card-title mb-0 text-primary fs-6">@job.Title</h5>
                                            <p class="card-subtitle mb-0 text-muted small">
                                                @(job.Company?.Name ?? job.Company?.StreetAddress ?? "N/A")
                                            </p>
                                        </div>
                                    </div>
                                    <p class="card-text small text-muted mb-1">
                                        <strong>Salary:</strong> $@(job.Salary.ToString("N0"))
                                    </p>
                                    <p class="card-text small text-muted mb-1">
                                        <strong>Location:</strong> @(job.StreetAddress ?? "N/A")
                                    </p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="badge bg-success">@(job.Status ?? "N/A")</span>
                                        <a asp-action="Details" asp-controller="Job" asp-area="JobSeeker" asp-route-id="@job.Id" class="btn btn-outline-primary btn-sm">
                                            Details
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <!-- Pagination -->
                <nav aria-label="Page navigation" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(ViewBag.Page == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-controller="Job" asp-area="JobSeeker" asp-route-page="@(ViewBag.Page - 1)" asp-route-search="@ViewBag.Search" asp-route-category="@Context.Request.Query["category"]" asp-route-location="@Context.Request.Query["location"]">Previous</a>
                        </li>
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(ViewBag.Page == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-controller="Job" asp-area="JobSeeker" asp-route-page="@i" asp-route-search="@ViewBag.Search" asp-route-category="@Context.Request.Query["category"]" asp-route-location="@Context.Request.Query["location"]">@i</a>
                            </li>
                        }
                        <li class="page-item @(ViewBag.Page == ViewBag.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-controller="Job" asp-area="JobSeeker" asp-route-page="@(ViewBag.Page + 1)" asp-route-search="@ViewBag.Search" asp-route-category="@Context.Request.Query["category"]" asp-route-location="@Context.Request.Query["location"]">Next</a>
                        </li>
                    </ul>
                </nav>
            }
            else
            {
                <div class="text-center">
                    <p class="text-muted">No jobs available at the moment.</p>
                </div>
            }
        </div>
    </div>
</div>