@model List<WorkNestify.Models.Models.Jobs.Job>

@{
    ViewData["Title"] = "Jobs List";
}

<div class="row justify-content-center">
    <div class="col-12">
        <!-- Search Bar -->
        <partial name="_SearchBarPartial"/>
    </div>

    <partial name="_JobFilterPartial"/>

    <div class="col-8">
        <!-- Job Listings -->
        <div class="mb-5">
            <h2 class="h4 mb-4 text-primary">Job Listings</h2>
            <!-- Loading spinner -->
            <div id="loading-spinner" class="text-center d-none">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>

            <div class="row row-cols-1 g-4" id="job-listings">
                @if (Model.Any())
                {
                    @foreach (var job in Model)
                    {
                        @await Html.PartialAsync("_JobCardPartial", job, new ViewDataDictionary(ViewData) { { "Layout", "wide" } })
                    }
                }
                else
                {
                    <div class="text-center">
                        <p class="text-muted">No jobs available at the moment.</p>
                    </div>
                }
            </div>
            
            <!-- Pagination with pagination.js and Bootstrap -->
            @if (ViewBag.TotalJobs > ViewBag.PageSize)
            {
                <nav aria-label="Job pagination" class="mt-4">
                    <div id="pagination-container" class="d-flex justify-content-center"></div>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script asp-append-version="true">
        window.jobFilterConfig = {
            totalJobs: @(ViewBag.TotalJobs ?? 0),
            pageSize: @(ViewBag.PageSize ?? 10),
            currentPage: @(ViewBag.CurrentPage ?? 1),
            search: '@Html.Raw(Context.Request.Query["search"])',
            category: '@Html.Raw(Context.Request.Query["category"])',
            location: '@Html.Raw(Context.Request.Query["location"])'
        }
    </script>
    <script src="~/js/PaginationRenderer.js" asp-append-version="true"></script>
}