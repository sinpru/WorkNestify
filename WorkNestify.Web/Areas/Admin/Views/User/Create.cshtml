@model WorkNestify.Models.Models.Users.ApplicationUser

@{
    ViewData["Title"] = "Add new User";
    ViewData["IndexAction"] = "Index";
}

<partial name="_ManagementNavigationPartial"/>
<partial name="_NotificationsPartial"/>

<form class="row" asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="col-md-6 mb-2">
        <div class="form-group mb-2">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control"/>
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="Role" class="form-label"></label>
            <select asp-for="Role" class="form-control" asp-items="ViewBag.Role">
                <option value="" selected disabled>Select a Role</option>
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-2">
            <label asp-for="CompanyId" class="form-label"></label>
            <select asp-for="CompanyId" class="form-control" asp-items="ViewBag.CompanyId">
                <option value="" selected disabled>Select a Company</option>
            </select>
            <span asp-validation-for="CompanyId" class="text-danger"></span>
        </div>
    </div>
    
    <div class="col-md-6 mb-2">
        <div class="form-group mb-2">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control"/>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="PasswordHash" class="form-label"></label>
            <input asp-for="PasswordHash" type="password" class="form-control"/>
            <span asp-validation-for="PasswordHash" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control"/>
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-12 mb-2">
        <div class="form-group d-flex justify-content-between mt-2">
            <a class="btn btn-outline-secondary d-flex align-items-center" asp-action="Index">
                <i class="fs-4 bi-x-lg me-1"></i> Cancel
            </a>

            <button type="submit" class="btn btn-primary d-flex align-items-center">
                <i class="fs-4 bi-check-circle me-1"></i> Add User
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
