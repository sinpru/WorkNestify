@model WorkNestify.Models.Models.Users.ApplicationUser

@{
    ViewData["Title"] = "Add New User";
    ViewData["IndexAction"] = "Index";
}

<partial name="_ManagementNavigationPartial" />

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0"><i class="bi bi-person-plus me-2"></i>Create New User</h2>
    </div>

    <div class="card-body p-4">
        <partial name="_NotificationsPartial" />

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display: none;"></div>

            <div class="row g-4">
                <!-- Left Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-gear"></i></span>
                            <select asp-for="Role" class="form-select" asp-items="ViewBag.Role">
                                <option value="" disabled selected>Select a Role</option>
                            </select>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompanyId" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-buildings"></i></span>
                            <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.CompanyId">
                                <option value="" disabled selected>Select a Company</option>
                            </select>
                        </div>
                        <span asp-validation-for="CompanyId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="Enter email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PasswordHash" class="form-label fw-bold">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="PasswordHash" type="password" class="form-control"
                                   placeholder="Enter password" />
                        </div>
                        <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="PhoneNumber" class="form-control"
                                   placeholder="Enter phone number" />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-lg me-2"></i>Cancel
                </a>
                <button type="submit"
                        class="btn btn-primary px-4">
                    <i class="bi bi-check-circle me-2"></i>Add User
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}