@model IEnumerable<WorkNestify.Models.Models.Users.ApplicationUser>

@{
    ViewData["Title"] = "User Management";
    ViewData["CreateAction"] = "Create";
    ViewData["CreateText"] = "Add New User";
}

<partial name="_ManagementNavigationPartial"/>
<partial name="_NotificationsPartial"/>

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show animate__animated animate__fadeIn" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table id="usersTable" class="table table-striped table-hover nowrap w-100 animate__animated animate__fadeIn">
    <thead class="animate__animated animate__slideInLeft">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                Phone Number
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Role)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company)
            </th>
            <th>
                Jobs Count
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#usersTable').DataTable({
                ajax: {
                    url: '/Admin/User/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'fullName' },
                    { data: 'email' },
                    { data: 'phoneNumber' },
                    { data: 'role' },
                    { data: 'company' },
                    { data: 'jobApplication' },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group animate__animated animate__fadeInUp" role="group">
                                <a href="/Admin/User/Edit/${data}" class="btn btn-primary animate__animated animate__zoomIn"> <i class="bi bi-pencil-square me-2"></i>Edit</a>
                                <a href="/Admin/User/Details/${data}" class="btn btn-info animate__animated animate__zoomIn"> <i class="bi bi-info-circle me-2"></i>Details</a>
                                <a href="/Admin/User/Delete/${data}" class="btn btn-danger animate__animated animate__zoomIn"> <i class="bi bi-trash-fill me-2"></i>Delete</a>
                                <a href="/Admin/User/ChangePassword/${data}" class="btn btn-warning animate__animated animate__zoomIn"> <i class="bi bi-key-fill me-2"></i>Change Password</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No users found"
                },
                "drawCallback": function(settings) {
                    $('#usersTable tbody tr').each(function(index) {
                        $(this).addClass('animate__animated animate__fadeInUp');
                        $(this).css('animation-delay', (index * 0.1) + 's');
                    });
                }
            });
        });
    </script>
}