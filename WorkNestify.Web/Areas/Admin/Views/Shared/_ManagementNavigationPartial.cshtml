@{
    string title = ViewData["Title"] as string ?? "Page Title";
    string? createAction = ViewData["CreateAction"] as string;
    string? createText = ViewData["CreateText"] as string;
    string? editAction = ViewData["EditAction"] as string;
    string? indexAction = ViewData["IndexAction"] as string;
    string? id = ViewData["Id"]?.ToString();
}

<header class="d-flex justify-content-between align-items-center">
    <h1 class="display-4">@title</h1>
    <div>
        @if (!string.IsNullOrEmpty(createAction))
        {
            <a class="btn btn-primary d-flex align-items-center" asp-action="@createAction">
                <i class="fs-4 bi-plus-lg me-1"></i> @createText
            </a>
        }
        @if (!string.IsNullOrEmpty(editAction) && !string.IsNullOrEmpty(id))
        {
            <a class="btn btn-primary d-flex align-items-center" asp-action="@editAction" asp-route-id="@id">
                <i class="fs-4 bi-pencil-square me-1"></i> Edit
            </a>
        }
        @if (!string.IsNullOrEmpty(indexAction))
        {
            <a class="btn btn-primary d-flex align-items-center" asp-action="@indexAction">
                <i class="fs-4 bi-arrow-left me-1"></i> Back to List
            </a>
        }
    </div>
</header>

<hr/>