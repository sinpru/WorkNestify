<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] - WorkNestify Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"/>
</head>
<body>
<main role="main" class="container-fluid">
    <div class="row flex-nowrap">
        <div class="col-auto col-md-3 col-xl-2 px-sm-2 px-0 bg-primary">
            <div class="d-flex flex-column align-items-center align-items-sm-start px-3 pt-2 min-vh-100">
                <a href="/" class="d-flex align-items-center pb-3 mb-md-0 me-md-auto text-light text-decoration-none">
                    <span class="fs-5 d-none d-sm-inline">WorkNestify</span>
                </a>
                <ul class="nav nav-pills flex-column mb-sm-auto mb-0 align-items-center align-items-sm-start" id="menu">
                    <!-- Home -->
                    <li class="nav-item">
                        <a class="nav-link align-middle px-0 text-light" asp-area="JobSeeker" asp-controller="Home" asp-action="Index">
                            <i class="fs-4 bi-house"></i> <span class="ms-1 d-none d-sm-inline">Home</span>
                        </a>
                    </li>
                    
                    <!-- Dashboard -->
                    <li>
                        <a class="nav-link px-0 align-middle text-light" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <i class="fs-4 bi-speedometer2"></i> <span class="ms-1 d-none d-sm-inline">Dashboard</span>
                        </a>
                    </li>

                    <!-- Companies -->
                    <li>
                        <a href="#companies" data-bs-toggle="collapse" class="nav-link px-0 align-middle text-light">
                            <i class="fs-4 bi-buildings"></i> <span class="ms-1 d-none d-sm-inline">Companies</span>
                        </a>
                        <ul class="collapse nav flex-column ms-1" id="companies" data-bs-parent="#menu">
                            <li class="w-100">
                                <a class="nav-link px-0 ms-2 text-light" asp-area="Admin" asp-controller="Company" asp-action="Index">
                                    <span class="d-none d-sm-inline">Companies List</span>
                                </a>
                            </li>
                            <li>
                                <a class="nav-link px-0 ms-2 text-light" asp-area="Admin" asp-controller="CompanyReview" asp-action="Index">
                                    <span class="d-none d-sm-inline">Company Reviews</span>
                                </a>
                            </li>
                            <li>
                                <a class="nav-link px-0 ms-2 text-light" asp-area="Admin" asp-controller="CompanySize" asp-action="Index">
                                    <span class="d-none d-sm-inline">Company Sizes</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Job Applications -->
                    <li>
                        <a href="#job-applications" data-bs-toggle="collapse" class="nav-link px-0 align-middle text-light">
                            <i class="fs-4 bi-file-earmark-text"></i> <span class="ms-1 d-none d-sm-inline">Job Applications</span>
                        </a>
                        <ul class="collapse nav flex-column ms-1" id="job-applications" data-bs-parent="#menu">
                            <li class="w-100">
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Job Applications</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Job Application Statuses</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- Jobs -->
                    <li>
                        <a href="#jobs" data-bs-toggle="collapse" class="nav-link px-0 align-middle text-light">
                            <i class="fs-4 bi-briefcase"></i> <span class="ms-1 d-none d-sm-inline">Jobs</span>
                        </a>
                        <ul class="collapse nav flex-column ms-1" id="jobs" data-bs-parent="#menu">
                            <li class="w-100">
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Jobs List</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Job Categories</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Job Levels</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Job Statuses</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Job Types</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li>
                        <a href="#users" data-bs-toggle="collapse" class="nav-link px-0 align-middle text-light">
                            <i class="fs-4 bi-people"></i> <span class="ms-1 d-none d-sm-inline">Users</span>
                        </a>
                        <ul class="collapse nav flex-column ms-1" id="users" data-bs-parent="#menu">
                            <li class="w-100">
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Job Seekers</span>
                                </a>
                            </li>
                            <li>
                                <a href="#" class="nav-link px-0 ms-2 text-light">
                                    <span class="d-none d-sm-inline">Employers</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
                <hr>
                <div class="dropdown pb-4">
                    <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle"
                       id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="https://github.com/mdo.png" alt="hugenerd" width="30" height="30"
                             class="rounded-circle">
                        <span class="d-none d-sm-inline mx-1">loser</span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                        <li><a class="dropdown-item" href="#">New project...</a></li>
                        <li><a class="dropdown-item" href="#">Settings</a></li>
                        <li><a class="dropdown-item" href="#">Profile</a></li>
                        <li>
                            <hr class="dropdown-divider">
                        </li>
                        <li><a class="dropdown-item" href="#">Sign out</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col py-3">
            <div class="container">
                @RenderBody()
            </div>
        </div>
    </div>
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>