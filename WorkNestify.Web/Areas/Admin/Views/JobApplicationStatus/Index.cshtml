@model IEnumerable<WorkNestify.DataAccess.Entities.JobApplications.JobApplicationStatus>

@{
    ViewData["Title"] = "Job Application Statuses Management";
}

<partial name="_ManagementNavigationPartial"/>

<table id="jobApplicationStatusesTable" class="table table-striped table-hover nowrap w-100">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#jobApplicationStatusesTable').DataTable({
                ajax: {
                    url: '/Admin/JobApplicationStatus/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'name' },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group" role="group">
                                <a href="/Admin/JobApplicationStatus/Details/${data}" class="btn btn-info"> <i class="bi bi-info-circle me-2"></i>Details</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No jobs found"
                }
            });
        });
    </script>
}