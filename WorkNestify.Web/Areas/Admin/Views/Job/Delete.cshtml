@model WorkNestify.DataAccess.Entities.Jobs.Job

@{
    ViewData["Title"] = "Delete Job";
    ViewData["IndexAction"] = "Index";
}

<partial name="_ManagementNavigationPartial"/>

<div class="alert alert-danger" role="alert">
    <h3 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Warning</h3>
    <p>
        Deleting this job will permanently remove all associated data. <strong>This action cannot be undone.</strong>
    </p>
</div>

<div class="row mt-4">
    <!-- Left Column: Job Highlights -->
    <div class="col-md-4">
        <h4>@Model.Title</h4>
        <p><strong>Company:</strong> @(Model.Company?.Name ?? "Not specified")</p>
        <p><strong>Salary:</strong> @(Model.Salary.ToString("C", new System.Globalization.CultureInfo("en-US")) ?? "Not provided")</p>
        <p><strong>Job Type:</strong> @(Model.JobType?.Name ?? "Not specified")</p>
        <p><strong>Status:</strong> @(Model.JobStatus?.Name ?? "Not specified")</p>
    </div>

    <!-- Right Column: Detailed Information -->
    <div class="col-md-8">
        <h4>Job Information</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">@(Model.JobCategory?.Description ?? "Not specified")</dd>

            <dt class="col-sm-4">Level</dt>
            <dd class="col-sm-8">@(Model.JobLevel?.Description ?? "Not specified")</dd>

            <dt class="col-sm-4">Location</dt>
            <dd class="col-sm-8">
                @(Model.StreetAddress ?? "Not provided")
                @if (Model.Province != null || Model.District != null || Model.Ward != null)
                {
                    <br />
                    <span>
                        @(Model.Ward?.Name ?? ""), @(Model.District?.Name ?? ""), @(Model.Province?.Name ?? "")
                    </span>
                }
            </dd>

            <dt class="col-sm-4">Start Date</dt>
            <dd class="col-sm-8">@(Model.StartDate?.ToString("dd/MM/yyyy") ?? "Not specified")</dd>

            <dt class="col-sm-4">End Date</dt>
            <dd class="col-sm-8">@(Model.EndDate?.ToString("dd/MM/yyyy") ?? "Not specified")</dd>

            <dt class="col-sm-4">Created Date</dt>
            <dd class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>

            <dt class="col-sm-4">Modified Date</dt>
            <dd class="col-sm-8">@Model.ModifiedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>
        </dl>
    </div>
</div>

<hr />

<div class="col-md-12">
    <h4>Description</h4>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div>@Html.Raw(Model.Description)</div>
    }
    else
    {
        <p class="text-muted">No description available</p>
    }
</div>

<div class="d-flex justify-content-between mt-4">
    <a class="btn btn-outline-secondary d-flex align-items-center" asp-action="Index">
        <i class="fs-4 bi-x-lg me-1"></i> Cancel
    </a>

    <!-- Delete Button with Confirmation Modal -->
    <button type="button" class="btn btn-danger d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
        <i class="fs-4 bi-trash3 me-1"></i> Delete
    </button>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="confirmDeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong>@Model.Title</strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>