@model WorkNestify.DataAccess.Entities.Jobs.Job

@{
    ViewData["Title"] = "Register New Job";
    ViewData["IndexAction"] = "Index";
}

<partial name="_ManagementNavigationPartial"/>

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form class="row" asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    
    <div class="col-md-6 mb-2">
        <div class="form-group mb-2">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" placeholder="Enter job title" required/>
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="CompanyId" class="form-label"></label>
            <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.CompanyId" required>
                <option value="" disabled selected>Select Company</option>
            </select>
            <span asp-validation-for="CompanyId" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="Salary" class="form-label"></label>
            <input asp-for="Salary" class="form-control" type="number" step="1000" placeholder="Enter salary"/>
            <span asp-validation-for="Salary" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-2">
            <label asp-for="JobTypeId" class="form-label"></label>
            <select asp-for="JobTypeId" class="form-select" asp-items="ViewBag.JobTypeId" required>
                <option value="" disabled selected>Select Job Type</option>
            </select>
            <span asp-validation-for="JobTypeId" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-2">
            <label asp-for="JobStatusId" class="form-label"></label>
            <select asp-for="JobStatusId" class="form-select" asp-items="ViewBag.JobStatusId" required>
                <option value="" disabled selected>Select Job Status</option>
            </select>
            <span asp-validation-for="JobStatusId" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-2">
            <label asp-for="JobLevelId" class="form-label"></label>
            <select asp-for="JobLevelId" class="form-select" asp-items="ViewBag.JobLevelId" required>
                <option value="" disabled selected>Select Job Level</option>
            </select>
            <span asp-validation-for="JobLevelId" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-2">
            <label asp-for="JobCategoryId" class="form-label"></label>
            <select asp-for="JobCategoryId" class="form-select" asp-items="ViewBag.JobCategoryId" required>
                <option value="" disabled selected>Select Job Category</option>
            </select>
            <span asp-validation-for="JobCategoryId" class="text-danger"></span>
        </div>
    </div>

    <div class="col-md-6 mb-2">
        <div class="form-group mb-2">
            <label asp-for="ProvinceId" class="form-label"></label>
            <select asp-for="ProvinceId" class="form-select" asp-items="ViewBag.ProvinceId" required>
                <option value="" disabled selected>Select Province</option>
            </select>
            <span asp-validation-for="ProvinceId" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="DistrictId" class="form-label"></label>
            <select asp-for="DistrictId" class="form-select" asp-items="ViewBag.DistrictId" required>
                <option value="" disabled selected>Select District</option>
            </select>
            <span asp-validation-for="DistrictId" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="WardCode" class="form-label"></label>
            <select asp-for="WardCode" class="form-select" asp-items="ViewBag.WardCode">
                <option value="" disabled selected>Select Ward</option>
            </select>
            <span asp-validation-for="WardCode" class="text-danger"></span>
        </div>
        
        <div class="form-group mb-2">
            <label asp-for="StreetAddress" class="form-label"></label>
            <input asp-for="StreetAddress" class="form-control" placeholder="Enter street address" required/>
            <span asp-validation-for="StreetAddress" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" type="date" class="form-control"/>
            <span asp-validation-for="StartDate" class="text-danger"></span>
        </div>

        <div class="form-group mb-2">
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" type="date" class="form-control"/>
            <span asp-validation-for="EndDate" class="text-danger"></span>
        </div>
    </div>
    

    <div class="col-md-12 mb-2">
        <div class="form-group">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" id="editor" class="form-control"></textarea>
            <div id="editor-word-count" class="small text-muted mt-1"></div>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group d-flex justify-content-between mt-2">
            <a class="btn btn-outline-secondary d-flex align-items-center" asp-action="Index">
                <i class="fs-4 bi-x-lg me-1"></i> Cancel
            </a>

            <button type="submit" class="btn btn-primary d-flex align-items-center">
                <i class="fs-4 bi-check-circle me-1"></i> Register Job Listing
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    @{ await Html.RenderPartialAsync("_FormScriptsPartial"); }
}
