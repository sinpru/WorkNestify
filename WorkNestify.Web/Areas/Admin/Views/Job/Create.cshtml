@model WorkNestify.Models.Models.Jobs.Job

@{
    ViewData["Title"] = "Register New Job";
    ViewData["IndexAction"] = "Index";
}

<partial name="_ManagementNavigationPartial" />

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0"><i class="bi bi-briefcase me-2"></i>Create New Job Listing</h2>
    </div>

    <div class="card-body p-4">
        <partial name="_NotificationsPartial" />

        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display: none;"></div>

            <div class="row g-4">
                <!-- Left Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-fonts"></i></span>
                            <input asp-for="Title" class="form-control" placeholder="Enter job title" />
                        </div>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CompanyId" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-buildings"></i></span>
                            <select asp-for="CompanyId" class="form-select" asp-items="ViewBag.CompanyId">
                                <option value="" disabled selected>Select Company</option>
                            </select>
                        </div>
                        <span asp-validation-for="CompanyId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Salary" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Salary" class="form-control" type="number" step="500000" min="2000000" placeholder="Enter salary" />
                        </div>
                        <span asp-validation-for="Salary" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Type" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-clock"></i></span>
                            <select asp-for="Type" class="form-select" asp-items="ViewBag.Type">
                                <option value="" disabled selected>Select Job Type</option>
                            </select>
                        </div>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-info-circle"></i></span>
                            <select asp-for="Status" class="form-select" asp-items="ViewBag.Status">
                                <option value="" disabled selected>Select Job Status</option>
                            </select>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Level" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-bar-chart-steps"></i></span>
                            <select asp-for="Level" class="form-select" asp-items="ViewBag.Level">
                                <option value="" disabled selected>Select Job Level</option>
                            </select>
                        </div>
                        <span asp-validation-for="Level" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="JobCategoryId" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tag"></i></span>
                            <select asp-for="JobCategoryId" class="form-select" asp-items="ViewBag.JobCategoryId">
                                <option value="" disabled selected>Select Job Category</option>
                            </select>
                        </div>
                        <span asp-validation-for="JobCategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="ProvinceId" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                            <select asp-for="ProvinceId" class="form-select" asp-items="ViewBag.ProvinceId">
                                <option value="" disabled selected>Select Province</option>
                            </select>
                        </div>
                        <span asp-validation-for="ProvinceId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DistrictId" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo"></i></span>
                            <select asp-for="DistrictId" class="form-select" asp-items="ViewBag.DistrictId">
                                <option value="" disabled selected>Select District</option>
                            </select>
                        </div>
                        <span asp-validation-for="DistrictId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WardCode" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-fill"></i></span>
                            <select asp-for="WardCode" class="form-select" asp-items="ViewBag.WardCode">
                                <option value="" disabled selected>Select Ward</option>
                            </select>
                        </div>
                        <span asp-validation-for="WardCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StreetAddress" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-house-door"></i></span>
                            <input asp-for="StreetAddress" class="form-control" placeholder="Enter street address" />
                        </div>
                        <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StartDate" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar-plus"></i></span>
                            <input asp-for="StartDate" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="EndDate" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar-minus"></i></span>
                            <input asp-for="EndDate" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Full Width Description -->
                <div class="col-12">
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text align-items-start pt-2"><i class="bi bi-text-paragraph"></i></span>
                            <textarea asp-for="Description" id="editor" class="form-control" rows="5"
                                      placeholder="Enter job description"></textarea>
                        </div>
                        <div id="editor-word-count" class="small text-muted mt-1"></div>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-lg me-2"></i>Cancel
                </a>
                <button type="submit"
                        class="btn btn-primary px-4">
                    <i class="bi bi-check-circle me-2"></i>Register Job
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FormScriptsPartial" />
}