@model IEnumerable<WorkNestify.DataAccess.Entities.Jobs.Job>

@{
    ViewData["Title"] = "Jobs Management";
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="display-4">@ViewData["Title"]</h1>

    <a class="btn btn-primary d-flex align-items-center" asp-action="Create">
        <i class="fs-4 bi-plus-lg me-1"></i> Create Job
    </a>
</div>

<hr/>

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table id="jobsTable" class="table table-striped table-hover display nowrap w-100">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StreetAddress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Salary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobCategory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#jobsTable').DataTable({
                ajax: {
                    url: '/Admin/Job/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'title' },
                    { data: 'company' },
                    { data: 'streetAddress' },
                    {
                        data: 'salary',
                        render: function (data) {
                            return '$' + data.toLocaleString(); // Format as currency
                        }
                    },
                    { data: 'jobType' },
                    { data: 'jobStatus' },
                    { data: 'jobCategory' },
                    {
                        data: 'createdDate',
                        render: function (data) {
                            return new Date(data).toLocaleDateString();
                        }
                    },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group" role="group">
                                <a href="/Admin/Job/Edit/${data}" class="btn btn-primary"> <i class="bi bi-pencil-square me-2"></i>Edit</a>
                                <a href="/Admin/Job/Details/${data}" class="btn btn-info"> <i class="bi bi-info-circle me-2"></i>Details</a>
                                <a href="/Admin/Job/Delete/${data}" class="btn btn-danger"> <i class="bi bi-trash-fill me-2"></i>Delete</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No jobs found"
                }
            });
        });
    </script>
}
