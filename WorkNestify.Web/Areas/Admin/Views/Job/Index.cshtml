@model IEnumerable<WorkNestify.Models.Models.Jobs.Job>

@{
    ViewData["Title"] = "Jobs Management";
    ViewData["CreateAction"] = "Create";
    ViewData["CreateText"] = "Register a job";
}

<partial name="_ManagementNavigationPartial"/>
<partial name="_NotificationsPartial"/>

<table id="jobsTable" class="table table-striped table-hover nowrap w-100">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.StreetAddress)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Salary)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Type)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.JobCategory)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            const table = $('#jobsTable').DataTable({
                ajax: {
                    url: '/Admin/Job/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'title' },
                    { data: 'company' },
                    { data: 'streetAddress' },
                    {
                        data: 'salary',
                        render: function (data) {
                            return data.toLocaleString('vi-VN') + ' ₫';
                        }
                    },
                    { data: 'type' },
                    { data: 'status' },
                    { data: 'jobCategory' },
                    {
                        data: 'createdDate',
                        render: function (data) {
                            return new Date(data).toLocaleDateString();
                        }
                    },
                    {
                        data: 'id',
                        render: function (data, type, row) {
                            return `<div class="btn-group" role="group">
                                <a href="/Admin/Job/Edit/${data}" class="btn btn-primary"> <i class="bi bi-pencil-square me-2"></i>Edit</a>
                                <a href="/Admin/Job/Details/${data}" class="btn btn-info"> <i class="bi bi-info-circle me-2"></i>Details</a>
                                <button class="btn btn-success accept-job" data-id="${data}" title="Accept job posting" ${row.status?.toLowerCase() === 'open' ? 'disabled' : ''}>
                                    <i class="bi bi-check-circle"></i> Accept
                                </button>
                                <button class="btn btn-warning decline-job" data-id="${data}" title="Decline job posting" ${row.status?.toLowerCase() === 'declined' ? 'disabled' : ''}>
                                    <i class="bi bi-x-circle"></i> Decline
                                </button>
                                <a href="/Admin/Job/Delete/${data}" class="btn btn-danger"> <i class="bi bi-trash-fill me-2"></i>Delete</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No jobs found"
                }
            });

            // Handle accept job
            $('#jobsTable').on('click', '.accept-job', function () {
                handleAcceptJob($(this), table);
            });

            // Handle decline job
            $('#jobsTable').on('click', '.decline-job', function () {
                handleDeclineJob($(this), table);
            });
        });
    </script>
    <script src="~/js/JobButtonHandlers.js" asp-append-version="true"></script>
}
