@model IEnumerable<WorkNestify.Models.Models.Companies.CompanyReview>

@{
    ViewData["Title"] = "Company Reviews Management";
    ViewData["CreateAction"] = "Create";
    ViewData["CreateText"] = "Write a company review";
}

<partial name="_ManagementNavigationPartial"/>
<partial name="_NotificationsPartial"/>

<table id="companyReviewsTable" class="table table-striped table-hover nowrap w-100">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Company)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApplicationUser)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#companyReviewsTable').DataTable({
                ajax: {
                    url: '/Admin/CompanyReview/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'company' },
                    { data: 'reviewer' },
                    { data: 'rating' },
                    {
                        data: 'createdDate',
                        render: function (data) {
                            return new Date(data).toLocaleDateString();
                        }
                    },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group" role="group">
                                <a href="/Admin/CompanyReview/Edit/${data}" class="btn btn-primary"> <i class="bi bi-pencil-square me-2"></i>Edit</a>
                                <a href="/Admin/CompanyReview/Details/${data}" class="btn btn-info"> <i class="bi bi-info-circle me-2"></i>Details</a>
                                <a href="/Admin/CompanyReview/Delete/${data}" class="btn btn-danger"> <i class="bi bi-trash-fill me-2"></i>Delete</a>
                            </div>`
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No reviews found"
                }
            });
        });
    </script>
}
