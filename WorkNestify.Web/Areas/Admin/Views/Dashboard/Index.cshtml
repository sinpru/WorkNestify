@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h1 class="mt-4 mb-4 animate__animated animate__fadeIn">Admin Dashboard</h1>

    <!-- Quick Stats Row -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card text-white bg-primary h-100 animate__animated animate__zoomIn">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-buildings fs-2 me-3"></i>
                        <div>
                            <h5 class="card-title">Total Companies</h5>
                            <p class="card-text fs-4" id="totalCompanies">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card text-white bg-success h-100 animate__animated animate__zoomIn" style="animation-delay: 0.1s;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-briefcase fs-2 me-3"></i>
                        <div>
                            <h5 class="card-title">Active Jobs</h5>
                            <p class="card-text fs-4" id="activeJobs">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card text-white bg-warning h-100 animate__animated animate__zoomIn" style="animation-delay: 0.2s;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-file-earmark-text fs-2 me-3"></i>
                        <div>
                            <h5 class="card-title">Pending Applications</h5>
                            <p class="card-text fs-4" id="pendingApplications">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="card text-white bg-info h-100 animate__animated animate__zoomIn" style="animation-delay: 0.3s;">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-star fs-2 me-3"></i>
                        <div>
                            <h5 class="card-title">Average Company Rating</h5>
                            <p class="card-text fs-4" id="avgRating">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="row">
        <!-- Recent Jobs Table -->
        <div class="col-xl-6 mb-4">
            <div class="card shadow animate__animated animate__fadeInUp">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-briefcase me-2"></i> Recent Job Postings
                </div>
                <div class="card-body">
                    <table id="recentJobsTable" class="table table-striped table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Title</th>
                                <th>Company</th>
                                <th>Status</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pending Applications Table -->
        <div class="col-xl-6 mb-4">
            <div class="card shadow animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
                <div class="card-header bg-warning text-white">
                    <i class="bi bi-file-earmark-text me-2"></i> Pending Job Applications
                </div>
                <div class="card-body">
                    <table id="pendingApplicationsTable" class="table table-striped table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Job Title</th>
                                <th>Applicant</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Reviews Snapshot -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-star me-2"></i> Latest Company Reviews
                </div>
                <div class="card-body">
                    <table id="recentReviewsTable" class="table table-striped table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Company</th>
                                <th>Rating</th>
                                <th>Content</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Populated via JavaScript -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_DataTablesScriptsPartial"/>
    <script asp-append-version="true">
        $(document).ready(function () {
            // Mock data fetching (replace with actual API calls)
            $.ajax({
                url: '/Admin/Dashboard/GetDashboardData', // Example endpoint
                method: 'GET',
                success: function (data) {
                    $('#totalCompanies').text(data.totalCompanies);
                    $('#activeJobs').text(data.activeJobs);
                    $('#pendingApplications').text(data.pendingApplications);
                    $('#avgRating').text(data.avgRating.toFixed(1) + ' ★');

                    // Recent Jobs Table
                    $('#recentJobsTable').DataTable({
                        data: data.recentJobs,
                        columns: [
                            { data: 'id' },
                            { data: 'title' },
                            { data: 'company.name' },
                            { data: 'status' },
                            { data: 'createdDate', render: function (data) { return new Date(data).toLocaleDateString(); } }
                        ],
                        pageLength: 5,
                        responsive: true
                    });

                    // Pending Applications Table
                    $('#pendingApplicationsTable').DataTable({
                        data: data.recentPendingApplications, // Updated to match new property name
                        columns: [
                            { data: 'id' },
                            { data: 'job.title' },
                            { data: 'applicationUser.fullName' },
                            { data: 'applicationDate', render: function (data) { return new Date(data).toLocaleDateString(); } }
                        ],
                        pageLength: 5,
                        responsive: true
                    });

                    // Recent Reviews Table
                    $('#recentReviewsTable').DataTable({
                        data: data.recentReviews,
                        columns: [
                            { data: 'id' },
                            { data: 'company.name' },
                            { data: 'rating', render: function (data) { return data + ' ★'; } },
                            { data: 'content', render: function (data) { return data.substring(0, 50) + '...'; } },
                            { data: 'createdDate', render: function (data) { return new Date(data).toLocaleDateString(); } }
                        ],
                        pageLength: 5,
                        responsive: true
                    });
                },
                error: function () {
                    alert('Error loading dashboard data.');
                }
            });
        });
    </script>
}