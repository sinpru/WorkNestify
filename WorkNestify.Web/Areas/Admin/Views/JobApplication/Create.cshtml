@model WorkNestify.Models.Models.JobApplications.JobApplication

@{
    ViewData["Title"] = "Register Job Application";
    ViewData["IndexAction"] = "Index";
}

<partial name="_ManagementNavigationPartial" />

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0"><i class="bi bi-file-earmark-text me-2"></i>Register Job Application</h2>
    </div>

    <div class="card-body p-4">
        <partial name="_NotificationsPartial" />

        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display: none;"></div>

            <div class="row g-4">
                <!-- Left Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="JobId" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                            <select asp-for="JobId" class="form-select" asp-items="ViewBag.JobId">
                                <option value="" disabled selected>Select a Job</option>
                            </select>
                        </div>
                        <span asp-validation-for="JobId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ApplicationUserId" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <select asp-for="ApplicationUserId" class="form-select" asp-items="ViewBag.ApplicationUserId">
                                <option value="" disabled selected>Select a User</option>
                            </select>
                        </div>
                        <span asp-validation-for="ApplicationUserId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-info-circle"></i></span>
                            <select asp-for="Status" class="form-select" asp-items="ViewBag.Status">
                                <option value="" disabled selected>Select a Status</option>
                            </select>
                        </div>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label for="coverLetter" class="form-label fw-bold">Cover Letter</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-file-text"></i></span>
                            <input id="coverLetter" name="coverLetterFile" type="file" class="form-control"
                                   accept=".pdf,.doc,.docx,.odt,.rtf,.txt" />
                        </div>
                        <small class="text-muted">Accepted: .pdf, .doc, .docx, .odt, .rtf, .txt</small>
                    </div>

                    <div class="mb-3">
                        <label for="resume" class="form-label fw-bold">Resume</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-file-person"></i></span>
                            <input id="resume" name="resumeFile" type="file" class="form-control"
                                   accept=".pdf,.doc,.docx,.odt,.rtf,.txt" />
                        </div>
                        <small class="text-muted">Accepted: .pdf, .doc, .docx, .odt, .rtf, .txt</small>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-lg me-2"></i>Cancel
                </a>
                <button type="submit"
                        class="btn btn-primary px-4">
                    <i class="bi bi-check-circle me-2"></i>Register Application
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}