@model WorkNestify.Models.Models.JobApplications.JobApplication

@{
    ViewData["Title"] = "Register Job Application";
    ViewData["IndexAction"] = "Index";
}

<partial name="_ManagementNavigationPartial"/>

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form class="row" enctype="multipart/form-data" asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="col-md-6">
        <div class="form-group mb-2">
            <label asp-for="JobId" class="form-label"></label>
            <select asp-for="JobId" class="form-control" asp-items="ViewBag.JobId" required>
                <option value="" selected disabled>Select a Job</option>
            </select>
        </div>

        <div class="form-group mb-2">
            <label asp-for="ApplicationUserId" class="form-label"></label>
            <select asp-for="ApplicationUserId" class="form-control" asp-items="ViewBag.ApplicationUserId" required>
                <option value="" selected disabled>Select an User</option>
            </select>
        </div>

        <div class="form-group mb-2">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-control" asp-items="ViewBag.Status" required>
                <option value="" selected disabled>Select a Status</option>
            </select>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-2">
            <label for="coverLetter" class="form-label">Cover Letter</label>
            <input id="coverLetter" name="coverLetterFile" type="file" class="form-control"
                   accept=".pdf,.doc,.docx,.odt,.rtf,.txt" required/>
        </div>

        <div class="form-group mb-2">
            <label for="resume" class="form-label">Resume</label>
            <input id="resume" name="resumeFile" type="file" class="form-control"
                   accept=".pdf,.doc,.docx,.odt,.rtf,.txt" required/>
        </div>
    </div>

    <div class="col-md-12 mb-2">
        <div class="form-group d-flex justify-content-between mt-2">
            <a class="btn btn-outline-secondary d-flex align-items-center" asp-action="Index">
                <i class="fs-4 bi-x-lg me-1"></i> Cancel
            </a>

            <button type="submit" class="btn btn-primary d-flex align-items-center">
                <i class="fs-4 bi-check-circle me-1"></i> Register Job Application
            </button>
        </div>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
