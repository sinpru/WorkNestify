@model IEnumerable<WorkNestify.Models.Models.JobApplications.JobApplication>

@{
    ViewData["Title"] = "Job Applications Management";
    ViewData["CreateAction"] = "Create";
    ViewData["CreateText"] = "Create a new application";
}

<partial name="_ManagementNavigationPartial"/>

<table id="jobApplicationsTable" class="table table-striped table-hover">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.ApplicationUser)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Job)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Status)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ApplicationDate)
        </th>
        <th>
            Actions
        </th>
    </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#jobApplicationsTable').DataTable({
                ajax: {
                    url: '/Admin/JobApplication/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'applicationUser' },
                    { data: 'job' },
                    { data: 'status' },
                    {
                        data: 'applicationDate',
                        render: function (data) {
                            return new Date(data).toLocaleDateString();
                        }
                    },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group" role="group">
                                <a href="/Admin/JobApplication/Edit/${data}" class="btn btn-primary"> <i class="bi bi-pencil-square me-2"></i>Edit</a>
                                <a href="/Admin/JobApplication/Details/${data}" class="btn btn-info"> <i class="bi bi-info-circle me-2"></i>Details</a>
                                <a href="/Admin/JobApplication/Delete/${data}" class="btn btn-danger"> <i class="bi bi-trash-fill me-2"></i>Delete</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    },
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No job applications found"
                }
            });
        });
    </script>
}
