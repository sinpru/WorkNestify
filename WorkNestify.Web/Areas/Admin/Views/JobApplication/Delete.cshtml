@model WorkNestify.Models.Models.JobApplications.JobApplication

@{
    ViewData["Title"] = "Delete Job Application";
    ViewData["IndexAction"] = "Index";
    ViewData["Name"] = "this application";
    ViewData["Id"] = @Model?.Id;
    ViewData["Description"] = @Model?.Job?.Description;
}

<partial name="_ManagementNavigationPartial"/>

<div class="alert alert-danger" role="alert">
    <h3 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Warning</h3>
    <p>
        Deleting this job will permanently remove all associated data. <strong>This action cannot be undone.</strong>
    </p>
</div>

<div class="row mt-4">
    <!-- Left Column: Job Application Highlights -->
    <div class="col-md-4">
        <h4>Job Application #@Model.Id</h4>
        <p><strong>Job:</strong> @(Model.Job?.Title ?? "Not specified")</p>
        <p><strong>Applicant:</strong> @(Model.ApplicationUser?.UserName ?? "Not specified")</p>
        <p><strong>Status:</strong> @(Model.Status ?? "Not provided")</p>
    </div>

    <!-- Right Column: Detailed Information -->
    <div class="col-md-8">
        <h4>Application Information</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-4">Cover Letter</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.CoverLetter))
                {
                    <a href="@Model.CoverLetter" target="_blank" class="btn btn-primary btn-sm">
                        <i class="bi bi-file-earmark-text me-1"></i> View Cover Letter
                    </a>
                }
                else
                {
                    <span>Not provided</span>
                }
            </dd>

            <dt class="col-sm-4">Resume</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.Resume))
                {
                    <a href="@Model.Resume" target="_blank" class="btn btn-primary btn-sm">
                        <i class="bi bi-file-earmark-text me-1"></i> View Resume
                    </a>
                }
                else
                {
                    <span>Not provided</span>
                }
            </dd>

            <dt class="col-sm-4">Application Date</dt>
            <dd class="col-sm-8">
                @(Model.ApplicationDate?.ToString("dd/MM/yyyy HH:mm:ss") ?? "Not specified")
            </dd>

            <dt class="col-sm-4">Modified Date</dt>
            <dd class="col-sm-8">
                @(Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm:ss") ?? "Not specified")
            </dd>

            <dt class="col-sm-4">Job Seeker</dt>
            <dd class="col-sm-8">
                @(Model.ApplicationUser?.FullName ?? "Not specified")
            </dd>

            <dt class="col-sm-4">Job Title</dt>
            <dd class="col-sm-8">
                @(Model.Job?.Title ?? "Not specified")
            </dd>

            <dt class="col-sm-4">Company</dt>
            <dd class="col-sm-8">
                @(Model.Job?.Company?.Name ?? "Not specified")
            </dd>
        </dl>
    </div>
</div>

<hr />

<partial name="_DescriptionPartial"/>
<partial name="_DeletePartial"/>