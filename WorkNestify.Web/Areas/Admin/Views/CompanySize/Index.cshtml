@model IEnumerable<WorkNestify.DataAccess.Entities.Companies.CompanySize>

@{
    ViewData["Title"] = "Company Sizes Management";
}

<partial name="_ManagementNavigationPartial"/>

<table id="companySizesTable" class="table table-striped table-hover nowrap w-100">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            Actions
        </th>
    </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#companySizesTable').DataTable({
                ajax: {
                    url: '/Admin/CompanySize/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'name' },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group" role="group">
                                <a href="/Admin/CompanySize/Details/${data}" class="btn btn-info"> <i class="bi bi-info-circle me-2"></i>Details</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No company sizes found"
                }
            });
        });
    </script>
}
