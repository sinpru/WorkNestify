@model IEnumerable<WorkNestify.Models.Models.Jobs.JobCategory>

@{
    ViewData["Title"] = "Job Categories Management";
    ViewData["CreateAction"] = "Create";
    ViewData["CreateText"] = "Add new category";
}

<partial name="_ManagementNavigationPartial"/>
<partial name="_NotificationsPartial"/>

<table id="jobCategoriesTable" class="table table-striped table-hover nowrap w-100 animate__animated animate__fadeIn">
    <thead class="animate__animated animate__slideInLeft">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#jobCategoriesTable').DataTable({
                ajax: {
                    url: '/Admin/JobCategory/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'name' },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group animate__animated animate__fadeInUp" role="group">
                                <a href="/Admin/JobCategory/Edit/${data}" class="btn btn-primary animate__animated animate__zoomIn"> <i class="bi bi-pencil-square me-2"></i>Edit</a>
                                <a href="/Admin/JobCategory/Details/${data}" class="btn btn-info animate__animated animate__zoomIn"> <i class="bi bi-info-circle me-2"></i>Details</a>
                                <a href="/Admin/JobCategory/Delete/${data}" class="btn btn-danger animate__animated animate__zoomIn"> <i class="bi bi-trash-fill me-2"></i>Delete</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No job categories found"
                },
                "drawCallback": function(settings) {
                    $('#jobCategoriesTable tbody tr').each(function(index) {
                        $(this).addClass('animate__animated animate__fadeInUp');
                        $(this).css('animation-delay', (index * 0.1) + 's');
                    });
                }
            });
        });
    </script>
}