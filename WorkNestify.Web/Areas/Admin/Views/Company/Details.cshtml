@model WorkNestify.DataAccess.Entities.Companies.Company

@{
    ViewData["Title"] = "Company Details";
    ViewData["EditAction"] = "Edit";
    ViewData["IndexAction"] = "Index";
    ViewData["Id"] = @Model?.Id;
}

<partial name="_ManagementNavigationPartial"/>

<div class="row mt-4">
    <!-- Left Column: Logo & Basic Info -->
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.Logo))
        {
            <img src="@Model.Logo" class="img-fluid" alt="@Model.Name Logo" style="max-height:100px;">
        }
        else
        {
            <p class="text-muted">No logo available</p>
        }
        <h4 class="mt-3">@Model.Name</h4>
        <p><strong>Industry:</strong> @Model.Industry</p>
        <p><strong>Company Size:</strong> @(Model.CompanySize?.Name ?? "Not specified")</p>
    </div>

    <!-- Right Column: Detailed Information -->
    <div class="col-md-8">
        <h4>Company Information</h4>
        <hr/>
        <dl class="row">
            <dt class="col-sm-4">Website</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.Website))
                {
                    <a href="@Model.Website" target="_blank">@Model.Website</a>
                }
                else
                {
                    <span class="text-muted">Not provided</span>
                }
            </dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <a href="mailto:@Model.Email">@Model.Email</a>
                }
                else
                {
                    <span class="text-muted">Not provided</span>
                }
            </dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@(Model.Phone ?? "Not provided")</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">
                @(Model.StreetAddress ?? "Not provided")
                @if (Model.Province != null || Model.District != null || Model.Ward != null)
                {
                    <br />
                    <span>
                        @(Model.Ward?.Name ?? ""), @(Model.District?.Name ?? ""), @(Model.Province?.Name ?? "")
                    </span>
                }
            </dd>

            <dt class="col-sm-4">Founded Date</dt>
            <dd class="col-sm-8">@(Model.FoundedDate?.ToString("dd/MM/yyyy") ?? "Not specified")</dd>

            <dt class="col-sm-4">Created Date</dt>
            <dd class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>

            <dt class="col-sm-4">Modified Date</dt>
            <dd class="col-sm-8">@Model.ModifiedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>
        </dl>
    </div>
</div>

<hr/>

<div class="col-md-12">
    <h4>Description</h4>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <div>@Html.Raw(Model.Description)</div>
    }
    else
    {
        <p class="text-muted">No description available</p>
    }
</div>