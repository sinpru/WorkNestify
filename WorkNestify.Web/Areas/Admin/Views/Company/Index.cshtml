@model IEnumerable<WorkNestify.Models.Models.Companies.Company>

@{
    ViewData["Title"] = "Companies Management";
    ViewData["CreateAction"] = "Create";
    ViewData["CreateText"] = "Register a company";
}

<partial name="_ManagementNavigationPartial"/>
<partial name="_NotificationsPartial"/>

<table id="companiesTable" class="table table-hover table-striped display nowrap w-100 animate__animated animate__fadeIn">
    <thead class="animate__animated animate__slideInLeft">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Phone)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.StreetAddress)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Industry)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Size)
        </th>
        <th>
            Actions
        </th>
    </tr>
    </thead>
    <tbody></tbody>
</table>

@section Scripts
{
    @{ await Html.RenderPartialAsync("_DataTablesScriptsPartial"); }
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#companiesTable').DataTable({
                ajax: {
                    url: '/Admin/Company/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'name' },
                    { data: 'email' },
                    { data: 'phone' },
                    { data: 'streetAddress' },
                    { data: 'industry' },
                    { data: 'size' },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group animate__animated animate__fadeInUp" role="group">
                                <a href="/Admin/Company/Edit/${data}" class="btn btn-primary animate__animated animate__zoomIn"> <i class="bi bi-pencil-square me-2"></i>Edit</a>
                                <a href="/Admin/Company/Details/${data}" class="btn btn-info animate__animated animate__zoomIn"> <i class="bi bi-info-circle me-2"></i>Details</a>
                                <a href="/Admin/Company/Delete/${data}" class="btn btn-danger animate__animated animate__zoomIn"> <i class="bi bi-trash-fill me-2"></i>Delete</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No companies found"
                },
                "drawCallback": function(settings) {
                    $('#companiesTable tbody tr').each(function(index) {
                        $(this).addClass('animate__animated animate__fadeInUp');
                        $(this).css('animation-delay', (index * 0.1) + 's');
                    });
                }
            });
        });
    </script>
}