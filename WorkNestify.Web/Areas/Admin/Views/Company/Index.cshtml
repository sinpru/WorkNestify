@model IEnumerable<WorkNestify.DataAccess.Entities.Companies.Company>

@{
    ViewData["Title"] = "Companies Management";
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="display-4">@ViewData["Title"]</h1>

    <a class="btn btn-primary d-flex align-items-center" asp-action="Create">
        <i class="fs-4 bi-plus-lg me-1"></i> Add Company
    </a>
</div>

<hr/>

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<table id="companiesTable" class="table table-hover table-striped display nowrap w-100">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Email)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Phone)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.StreetAddress)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Industry)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.CompanySize)
        </th>
        <th>
            Actions
        </th>
    </tr>
    </thead>
    <tbody>
    @* @foreach (var item in Model) { *@
    @*         <tr> *@
    @*             <td class="align-middle"> *@
    @*                 @Html.DisplayFor(modelItem => item.Name) *@
    @*             </td> *@
    @*             <td class="align-middle"> *@
    @*                 @Html.DisplayFor(modelItem => item.Email) *@
    @*             </td> *@
    @*             <td class="align-middle"> *@
    @*                 @Html.DisplayFor(modelItem => item.Phone) *@
    @*             </td> *@
    @*             <td class="align-middle"> *@
    @*                 @Html.DisplayFor(modelItem => item.StreetAddress) *@
    @*             </td> *@
    @*             <td class="align-middle"> *@
    @*                 @Html.DisplayFor(modelItem => item.Industry) *@
    @*             </td> *@
    @*             <td class="align-middle"> *@
    @*                 @Html.DisplayFor(modelItem => item.CompanySize.Name) *@
    @*             </td> *@
    @*             <td class="d-flex flex-column gap-2"> *@
    @*                 <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a> *@
    @*                 <a class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a> *@
    @*                 <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a> *@
    @*             </td> *@
    @*         </tr> *@
    @* } *@
    </tbody>
</table>

@section Scripts
{
    <script asp-append-version="true">
        $(document).ready(function () {
            $('#companiesTable').DataTable({
                ajax: {
                    url: '/Admin/Company/GetAll',
                    dataSrc: 'data'
                },
                columns: [
                    { data: 'name' },
                    { data: 'email' },
                    { data: 'phone' },
                    { data: 'streetAddress' },
                    { data: 'industry' },
                    { data: 'companySize' },
                    {
                        data: 'id',
                        render: function (data) {
                            return `<div class="btn-group" role="group">
                                <a href="/Admin/Company/Edit/${data}" class="btn btn-primary"> <i class="bi bi-pencil-square me-2"></i>Edit</a>
                                <a href="/Admin/Company/Details/${data}" class="btn btn-info"> <i class="bi bi-info-circle me-2"></i>Details</a>
                                <a href="/Admin/Company/Delete/${data}" class="btn btn-danger"> <i class="bi bi-trash-fill me-2"></i>Delete</a>
                            </div>`;
                        },
                        orderable: false,
                        searchable: false
                    }
                ],
                responsive: true,
                dom: 'Bfrtip',
                buttons: [
                    'copy', 'csv', 'excel', 'pdf', 'print'
                ],
                language: {
                    emptyTable: "No companies found"
                }
            });
        });
    </script>
}
