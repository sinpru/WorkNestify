@model WorkNestify.Models.Models.Companies.Company

@{
    ViewData["Title"] = "Register New Company";
    ViewData["IndexAction"] = "Index";
}

<partial name="_ManagementNavigationPartial" />

<div class="card shadow-sm mt-4">
    <div class="card-header bg-primary text-white">
        <h2 class="mb-0"><i class="bi bi-buildings me-2"></i>Create New Company</h2>
    </div>

    <div class="card-body p-4">
        <partial name="_NotificationsPartial" />

        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display: none;"></div>

            <div class="row g-4">
                <!-- Left Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-building"></i></span>
                            <input asp-for="Name" class="form-control" placeholder="Enter company name" />
                        </div>
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Website" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-globe"></i></span>
                            <input asp-for="Website" class="form-control" placeholder="https://example.com" />
                        </div>
                        <span asp-validation-for="Website" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="email@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input asp-for="Phone" class="form-control" placeholder="+1 234 567 890" />
                        </div>
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Size" class="form-label fw-bold">Company Size</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-people"></i></span>
                            <select asp-for="Size" class="form-select" asp-items="ViewBag.Size">
                                <option value="" disabled selected>Select a Size</option>
                            </select>
                        </div>
                        <span asp-validation-for="Size" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Industry" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-gear"></i></span>
                            <input asp-for="Industry" class="form-control" placeholder="e.g., Tech, Retail" />
                        </div>
                        <span asp-validation-for="Industry" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="ProvinceId" class="form-label fw-bold">Province</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                            <select asp-for="ProvinceId" class="form-select" asp-items="ViewBag.ProvinceId">
                                <option value="" disabled selected>Select Province</option>
                            </select>
                        </div>
                        <span asp-validation-for="ProvinceId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DistrictId" class="form-label fw-bold">District</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo"></i></span>
                            <select asp-for="DistrictId" class="form-select" asp-items="ViewBag.DistrictId">
                                <option value="" disabled selected>Select District</option>
                            </select>
                        </div>
                        <span asp-validation-for="DistrictId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="WardCode" class="form-label fw-bold">Ward</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-geo-fill"></i></span>
                            <select asp-for="WardCode" class="form-select" asp-items="ViewBag.WardCode">
                                <option value="" disabled selected>Select Ward</option>
                            </select>
                        </div>
                        <span asp-validation-for="WardCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StreetAddress" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-house-door"></i></span>
                            <input asp-for="StreetAddress" class="form-control" placeholder="Enter company address" />
                        </div>
                        <span asp-validation-for="StreetAddress" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FoundedDate" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                            <input asp-for="FoundedDate" type="date" class="form-control" />
                        </div>
                        <span asp-validation-for="FoundedDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Logo" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <button id="toggleMode" class="btn btn-outline-secondary" type="button" onclick="logoInputToggle()">
                                <i class="bi bi-link-45deg"></i>/<i class="bi bi-file-earmark-image"></i>
                            </button>
                            <input id="logoUrl" asp-for="Logo" type="url" class="form-control"
                                   placeholder="https://example.com/logo.png" />
                            <input id="logoFile" name="file" type="file" class="form-control d-none" accept="image/*" />
                        </div>
                        <small class="text-muted">Enter a URL or upload an image file</small>
                        <span asp-validation-for="Logo" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Full Width Description -->
                <div class="col-12">
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text align-items-start pt-2"><i class="bi bi-text-paragraph"></i></span>
                            <textarea asp-for="Description" id="editor" class="form-control" rows="5"
                                      placeholder="Enter company description"></textarea>
                        </div>
                        <div id="editor-word-count" class="small text-muted mt-1"></div>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 d-flex justify-content-end gap-2">
                <a asp-action="Index"
                   class="btn btn-outline-secondary px-4">
                    <i class="bi bi-x-lg me-2"></i>Cancel
                </a>
                <button type="submit"
                        class="btn btn-primary px-4">
                    <i class="bi bi-check-circle me-2"></i>Create Company
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_FormScriptsPartial" />
    <script src="~/js/LogoInputToggle.js" asp-append-version="true"></script>
}