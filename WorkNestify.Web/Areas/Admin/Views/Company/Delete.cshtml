@model WorkNestify.DataAccess.Entities.Companies.Company

@{
    ViewData["Title"] = "Delete Company";
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="display-4">@ViewData["Title"]</h1>

    <a class="btn btn-primary d-flex align-items-center" asp-action="Index">
        <i class="fs-4 bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<hr/>

<div class="alert alert-danger" role="alert">
    <h3 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Warning</h3>
    <p>
        Deleting this company will permanently remove all associated data. <strong>This action cannot be undone.</strong>
    </p>
</div>

<div class="row mt-4">
    <!-- Left Column: Logo & Basic Info -->
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrEmpty(Model.Logo))
        {
            <img src="@Model.Logo" class="img-fluid" alt="@Model.Name Logo" style="max-height: 150px;">
        }
        <h4 class="mt-3">@Model.Name</h4>
        <p><strong>Industry:</strong> @Model.Industry</p>
        <p><strong>Company Size:</strong> @Model.CompanySize.Name</p>
    </div>

    <!-- Right Column: Detailed Information -->
    <div class="col-md-8">
        <h4>Company Information</h4>
        <hr/>
        <dl class="row">
            <dt class="col-sm-4">Website</dt>
            <dd class="col-sm-8">
                <a href="@Model.Website" target="_blank">@Model.Website</a>
            </dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">
                <a href="mailto:@Model.Email">@Model.Email</a>
            </dd>

            <dt class="col-sm-4">Phone</dt>
            <dd class="col-sm-8">@Model.Phone</dd>

            <dt class="col-sm-4">Address</dt>
            <dd class="col-sm-8">@Model.StreetAddress</dd>

            <dt class="col-sm-4">Founded Date</dt>
            <dd class="col-sm-8">@Model.FoundedDate?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Created Date</dt>
            <dd class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>

            <dt class="col-sm-4">Modified Date</dt>
            <dd class="col-sm-8">@Model.ModifiedDate.ToString("dd/MM/yyyy HH:mm:ss")</dd>
        </dl>
    </div>
</div>

<hr/>

<div class="col-md-12">
    <h4>Description</h4>
    <div>@Html.Raw(@Model.Description)</div>
</div>

<div class="d-flex justify-content-between mt-4">
    <a class="btn btn-outline-secondary d-flex align-items-center" asp-action="Index">
        <i class="fs-4 bi-x-lg me-1"></i> Cancel
    </a>

    <!-- Delete Button with Confirmation Modal -->
    <button type="button" class="btn btn-danger d-flex align-items-center" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
        <i class="fs-4 bi-trash3 me-1"></i> Delete
    </button>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="confirmDeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong>@Model.Name</strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id"/>
                    <button type="submit" class="btn btn-danger">Confirm Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>