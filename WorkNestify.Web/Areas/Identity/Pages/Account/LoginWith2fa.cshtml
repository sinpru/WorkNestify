@page
@model LoginWith2faModel

@{
    ViewData["Title"] = "Two-Factor Authentication";
    Layout = "_AuthLayout";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="card-title text-center mb-4">
            <i class="bi bi-shield-lock-fill me-2"></i>Two-Factor Authentication
        </h1>

        <p class="text-center mb-4">
            Enter the code from your authenticator app below.
        </p>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <input asp-for="RememberMe" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.TwoFactorCode" class="form-label fw-bold">
                    <i class="bi bi-key-fill me-2"></i>Authenticator Code
                </label>
                <input asp-for="Input.TwoFactorCode" class="form-control"
                       autocomplete="off"
                       placeholder="Enter 6-digit code"/>
                <span asp-validation-for="Input.TwoFactorCode" class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Input.RememberMachine" class="form-check-input"/>
                <label asp-for="Input.RememberMachine" class="form-check-label">
                    <i class="bi bi-check-square me-2"></i>
                    @Html.DisplayNameFor(m => m.Input.RememberMachine)
                </label>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>

            <div class="text-center">
                <p class="mb-0">
                    No access to your authenticator?
                    <a id="recovery-code-login" asp-page="./LoginWithRecoveryCode" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary">
                        <i class="bi bi-life-preserver me-1"></i>Use a recovery code
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}