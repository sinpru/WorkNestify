@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = "_AuthLayout";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="card-title text-center mb-4">
            <i class="bi bi-person-circle me-2"></i>Welcome Back
        </h1>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-bold">
                    <i class="bi bi-envelope-fill me-2"></i>Email
                </label>
                <input asp-for="Input.Email" class="form-control"
                       autocomplete="username"
                       aria-required="true"
                       placeholder="name@example.com"/>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label fw-bold">
                    <i class="bi bi-lock-fill me-2"></i>Password
                </label>
                <input asp-for="Input.Password" class="form-control"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder="••••••••"/>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe"/>
                    <label class="form-check-label" asp-for="Input.RememberMe">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword" class="text-muted">
                    <i class="bi bi-question-circle me-1"></i>Forgot password?
                </a>
            </div>

            <button id="login-submit" type="submit" class="btn btn-primary w-100 mb-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>

            <div class="text-center">
                <p class="mb-2">
                    New here?
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary">
                        <i class="bi bi-person-plus me-1"></i>Create an account
                    </a>
                </p>
                <p class="mb-0">
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-muted">
                        <i class="bi bi-envelope-paper me-1"></i>Resend email confirmation
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@if (Model.ExternalLogins?.Count > 0)
{
    <div class="card mt-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title text-center mb-3">
                <i class="bi bi-globe me-2"></i>Or sign in with
            </h5>
            <form id="external-account" asp-page="./ExternalLogin"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post"
                  class="text-center">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit"
                            class="btn btn-outline-primary m-1"
                            name="provider"
                            value="@provider.Name"
                            title="Log in using your @provider.DisplayName account">
                        @switch (provider.Name.ToLower())
                        {
                            case "google":
                                <i class="bi bi-google me-2"></i>
                                break;
                            case "facebook":
                                <i class="bi bi-facebook me-2"></i>
                                break;
                            case "twitter":
                                <i class="bi bi-twitter me-2"></i>
                                break;
                            default:
                                <i class="bi bi-person-circle me-2"></i>
                                break;
                        }
                        @provider.DisplayName
                    </button>
                }
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="https://accounts.google.com/gsi/client" async></script>
}