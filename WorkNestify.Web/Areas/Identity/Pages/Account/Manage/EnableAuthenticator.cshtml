@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="row">
    <div class="col-md-12">
        <h3><i class="bi bi-shield-lock me-2"></i>@ViewData["Title"]</h3>
        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="card">
            <div class="card-body">
                <p><i class="bi bi-info-circle me-2"></i>To use an authenticator app, follow these steps:</p>

                <ol class="list-group list-group-numbered">
                    <li class="list-group-item">
                        <h5><i class="bi bi-download me-2"></i>Download an app</h5>
                        <p>
                            Install a two-factor authenticator app like Microsoft Authenticator for
                            <a href="https://go.microsoft.com/fwlink/?Linkid=825072" class="link-primary">
                                <i class="bi bi-android2 me-1"></i>Android
                            </a> and
                            <a href="https://go.microsoft.com/fwlink/?Linkid=825073" class="link-primary">
                                <i class="bi bi-apple me-1"></i>iOS
                            </a> or Google Authenticator for
                            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&hl=en" class="link-primary">
                                <i class="bi bi-android2 me-1"></i>Android
                            </a> and
                            <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" class="link-primary">
                                <i class="bi bi-apple me-1"></i>iOS
                            </a>.
                        </p>
                    </li>
                    <li class="list-group-item">
                        <h5><i class="bi bi-qr-code me-2"></i>Scan QR code or enter key</h5>
                        <p>
                            Scan the QR code below or manually enter this key:
                            <kbd class="bg-dark text-light">@Model.SharedKey</kbd>
                            into your authenticator app. (Spaces and casing do not matter.)
                        </p>
                        <div class="alert alert-info alert-dismissible fade show" role="alert">
                            <i class="bi bi-info-circle me-2"></i>
                            Learn how to
                            <a href="https://go.microsoft.com/fwlink/?Linkid=852423" class="alert-link">enable QR code generation</a>.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        <div id="qrCode" class="my-3 text-center"></div>
                        <div id="qrCodeData" data-url="@Model.AuthenticatorUri" class="d-none"></div>
                    </li>
                    <li class="list-group-item">
                        <h5><i class="bi bi-check2-square me-2"></i>Verify the code</h5>
                        <p>
                            After scanning the QR code or entering the key, your authenticator app will generate a unique code.
                            Enter it below to confirm.
                        </p>
                        <form id="send-code" method="post">
                            <div class="form-floating mb-3">
                                <input asp-for="Input.Code" class="form-control" autocomplete="off"
                                       placeholder="Verification code" />
                                <label asp-for="Input.Code" class="form-label">
                                    <i class="bi bi-123 me-2"></i>Verification code
                                </label>
                                <span asp-validation-for="Input.Code" class="text-danger"></span>
                            </div>
                            <button type="submit" class="w-100 btn btn-lg btn-primary">
                                <i class="bi bi-check-circle me-2"></i>Verify
                            </button>
                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                        </form>
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}