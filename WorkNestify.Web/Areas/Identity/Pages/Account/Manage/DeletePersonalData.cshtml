@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="row">
    <div class="col-md-12">
        <h3><i class="bi bi-person-x me-2"></i>@ViewData["Title"]</h3>

        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <p>
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
            </p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>

        <div class="card">
            <div class="card-body">
                <form id="delete-user" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    @if (Model.RequirePassword)
                    {
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password"
                                   aria-required="true" placeholder="Password" />
                            <label asp-for="Input.Password" class="form-label">
                                <i class="bi bi-lock me-2"></i>Password
                            </label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                    }

                    <button class="w-100 btn btn-lg btn-danger" type="submit">
                        <i class="bi bi-trash me-2"></i>Delete data and close my account
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}