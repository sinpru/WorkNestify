@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="row">
    <div class="col-md-12">
        <h3><i class="bi bi-file-person me-2"></i>@ViewData["Title"]</h3>

        <div class="card">
            <div class="card-body">
                <p>
                    <i class="bi bi-info-circle me-2"></i>
                    Your account contains personal data that you have provided. This page allows you to download or delete that data.
                </p>
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    <p>
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
                    </p>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>

                <div class="d-flex gap-2">
                    <form id="download-data" asp-page="DownloadPersonalData" method="post">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-download me-2"></i>Download
                        </button>
                    </form>
                    <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Delete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}