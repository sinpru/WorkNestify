@page
@model ResendEmailConfirmationModel

@{
    ViewData["Title"] = "Resend Email Confirmation";
    Layout = "_AuthLayout";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="card-title text-center mb-4">
            <i class="bi bi-envelope-paper me-2"></i>Resend Confirmation
        </h1>

        <form method="post">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label fw-bold">
                    <i class="bi bi-envelope-fill me-2"></i>Email
                </label>
                <input asp-for="Input.Email" class="form-control"
                       aria-required="true"
                       placeholder="name@example.com"/>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 mb-3">
                <i class="bi bi-send me-2"></i>Resend
            </button>

            <div class="text-center">
                <p class="mb-0">
                    Back to
                    <a asp-page="./Login" class="text-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign in
                    </a>
                </p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}