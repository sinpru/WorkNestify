@using WorkNestify.Utilities.Constants
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - WorkNestify</title>
    <link rel="stylesheet" href="~/lib/bootswatch/lux/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/animate.css/animate.min.css"/>
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css"/>
    <link rel="stylesheet" href="~/lib/datatables/buttons.bootstrap5.min.css"/>
    <link rel="stylesheet" href="~/lib/datatables/responsive.bootstrap5.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <image src=""/>
                WorkNestify
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="JobSeeker" asp-controller="Home"
                           asp-action="Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="JobSeeker" asp-controller="Job" asp-action="Index">
                            Job Listing
                        </a>
                    </li>

                    <!-- Job Listing (visible only to users with the 'Employer' role) -->
                    @if (User.Identity.IsAuthenticated && User.IsInRole(Roles.Employer))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Employer" asp-controller="Job" asp-action="Index">
                                Job Management
                            </a>
                        </li>
                    }

                    <!-- Admin Dashboard (visible only to users with the 'Admin' role) -->
                    @if (User.Identity.IsAuthenticated && User.IsInRole(Roles.Admin))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                Admin Dashboard
                            </a>
                        </li>
                    }
                    
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="JobSeeker" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="container pb-3">
    @RenderBody()
</main>


<footer class="border-top text-muted text-center position-absolute bottom-0 w-100 text-nowrap py-3">
    <div class="container">
        &copy; 2025 - WorkNestify - <a asp-area="JobSeeker" asp-controller="Home" asp-action="Privacy">Privacy</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="https://accounts.google.com/gsi/client" async></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>