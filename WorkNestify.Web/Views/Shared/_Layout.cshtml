@using WorkNestify.Utilities.Constants
<!DOCTYPE html>
<html lang="en" class="h-100">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - WorkNestify</title>
    <link rel="icon" type="image/x-icon" href="~/assets/images/monogram.png"/>
    <link rel="stylesheet" href="~/lib/bootswatch/lux/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css"/>
    <link rel="stylesheet" href="~/lib/datatables/buttons.bootstrap5.min.css"/>
    <link rel="stylesheet" href="~/lib/datatables/responsive.bootstrap5.min.css"/>
    <link rel="stylesheet" href="~/lib/animate.css/animate.min.css"/>
</head>
<body class="d-flex flex-column min-vh-100">
<header class="sticky-top">
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <img src="" alt=""/>
                WorkNestify
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="JobSeeker" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="JobSeeker" asp-controller="Job" asp-action="Index">
                            <i class="bi bi-briefcase me-1"></i>Job Listing
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated && User.IsInRole(Roles.Employer))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-gear me-1"></i> Management
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item text-dark" asp-area="Employer" asp-controller="Job"
                                       asp-action="Index">
                                        Job Management
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item text-dark" asp-area="Employer" asp-controller="JobApplication"
                                       asp-action="Index">
                                        Job Application Management
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    @if (User.Identity.IsAuthenticated && User.IsInRole(Roles.Admin))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Admin" asp-controller="Dashboard"
                               asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>Admin Dashboard
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="JobSeeker" asp-controller="Home" asp-action="Privacy">
                            <i class="bi bi-shield-lock me-1"></i>Privacy
                        </a>
                    </li>
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>

<main role="main" class="container pb-3 flex-grow-1">
    @RenderBody()
</main>

<footer class="border-top text-muted text-center text-nowrap py-3">
    <div class="container">
        © 2025 - WorkNestify - <a asp-area="JobSeeker" asp-controller="Home" asp-action="Privacy">
            <i class="bi bi-shield-lock me-1"></i>Privacy
        </a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/signalr/signalr.min.js"></script>
<script src="~/lib/paginationjs/pagination.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>