@using Microsoft.AspNetCore.Identity
@using Microsoft.IdentityModel.Tokens
@using WorkNestify.Models.Models.Users

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link text-dark dropdown-toggle" href="#" id="profileDropdown" role="button" 
               data-bs-toggle="dropdown" aria-expanded="false">
                Hello <strong>@UserManager.GetUserName(User)!</strong>
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                <li>
                    <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">
                        <i class="bi bi-person-circle me-1"></i>Profile
                    </a>
                </li>
                <li>
                    <a class="dropdown-item" asp-area="JobSeeker" asp-controller="JobApplication" asp-action="Index">
                        <i class="bi bi-file-earmark-text me-1"></i>My Job Application
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" 
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item btn btn-link text-danger">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-primary me-2" id="register" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus me-1"></i>Register
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-secondary" id="login" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-left me-1"></i>Login
            </a>
        </li>
    }
</ul>